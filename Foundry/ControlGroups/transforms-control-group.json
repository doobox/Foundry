{
  "controls": [
    {
      "id": "transformsMode",
      "label": "Type",
      "type": "select",
      "presentation": "segmented",
      "responsive": false,
      "defaults": {
        "xs": "none"
      },
      "options": [
        {
          "title": "None",
          "value": "none"
        },
        {
          "title": "Static",
          "value": "static"
        },
        {
          "title": "Hover",
          "value": "hover"
        }
      ]
    },
    {
      "id": "hoverTrigger",
      "label": "Hover Trigger",
      "type": "select",
      "responsive": false,
      "defaults": {
        "xs": "self"
      },
      "options": [
        {
          "title": "This Part",
          "value": "self"
        },
        {
          "title": "Parent Part",
          "value": "parent"
        },
        {
          "title": "Part ID",
          "value": "custom"
        }
      ],
      "visibleWhen": {
        "id": "transformsMode",
        "value": "hover"
      }
    },
    {
      "id": "hoverTriggerID",
      "label": "Part ID",
      "type": "text",
      "responsive": false,
      "defaults": {
        "xs": ""
      },
      "visibleWhen": {
        "all": [
          {
            "id": "transformsMode",
            "value": "hover"
          },
          {
            "id": "hoverTrigger",
            "value": "custom"
          }
        ]
      },
      "tooltip": "The HTML ID of any part on this page, without the #."
    },
    {
      "id": "transformsState",
      "label": "State",
      "type": "select",
      "presentation": "segmented",
      "responsive": false,
      "defaults": {
        "xs": "normal"
      },
      "options": [
        {
          "title": "Normal",
          "value": "normal"
        },
        {
          "title": "Hovered",
          "value": "hover"
        }
      ],
      "visibleWhen": {
        "id": "transformsMode",
        "value": "hover"
      }
    },
    {
      "id": "transformsOrigin",
      "label": "Origin",
      "type": "select",
      "defaults": {
        "xs": "center"
      },
      "responsive": true,
      "visibleWhen": {
        "any": [
          {
            "id": "transformsMode",
            "value": "static"
          },
          {
            "all": [
              {
                "id": "transformsMode",
                "value": "hover"
              },
              {
                "id": "transformsState",
                "value": "normal"
              }
            ]
          }
        ]
      },
      "options": [
        {
          "title": "Center",
          "value": "center"
        },
        {
          "title": "Top left",
          "value": "top left"
        },
        {
          "title": "Top",
          "value": "top"
        },
        {
          "title": "Top right",
          "value": "top right"
        },
        {
          "title": "Left",
          "value": "left"
        },
        {
          "title": "Right",
          "value": "right"
        },
        {
          "title": "Bottom left",
          "value": "bottom left"
        },
        {
          "title": "Bottom",
          "value": "bottom"
        },
        {
          "title": "Bottom right",
          "value": "bottom right"
        }
      ]
    },
    {
      "id": "transformsScale",
      "label": "Scale",
      "type": "number",
      "defaults": {
        "xs": 100
      },
      "responsive": true,
      "visibleWhen": {
        "any": [
          {
            "id": "transformsMode",
            "value": "static"
          },
          {
            "all": [
              {
                "id": "transformsMode",
                "value": "hover"
              },
              {
                "id": "transformsState",
                "value": "normal"
              }
            ]
          }
        ]
      },
      "minimum": 0,
      "maximum": 1000,
      "step": 1,
      "units": "%"
    },
    {
      "id": "transformsRotate",
      "label": "Rotate",
      "type": "number",
      "defaults": {
        "xs": 0
      },
      "responsive": true,
      "visibleWhen": {
        "any": [
          {
            "id": "transformsMode",
            "value": "static"
          },
          {
            "all": [
              {
                "id": "transformsMode",
                "value": "hover"
              },
              {
                "id": "transformsState",
                "value": "normal"
              }
            ]
          }
        ]
      },
      "minimum": -360,
      "maximum": 360,
      "step": 1,
      "units": "deg"
    },
    {
      "id": "transformsTranslateX",
      "label": "Translate horizontal",
      "type": "text",
      "defaults": {
        "xs": "0px"
      },
      "responsive": true,
      "visibleWhen": {
        "any": [
          {

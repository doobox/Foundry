            "all": [
              {
                "id": "transformsMode",
                "value": "hover"
              },
              {
                "id": "transformsState",
                "value": "normal"
              }
            ]
          }
        ]
      },
      "tooltip": "Signed CSS length or percentage, for example -10px, 50% or 10vw. Unitless zero is accepted."
    },
    {
      "id": "transformsTranslateY",

{
  "type": "foreground",
  "name": "Foreground",
  "systemImage": "paintpalette",
  "controls": [
    {
      "type": "themeColors",
      "id": "theme",
      "label": "Colour",
      "defaults": {
        "xs": "inherit"
      }
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "responsive": false,
      "defaults": { "xs": "normal" },
      "options": [
        { "title": "Normal", "value": "normal" },
        { "title": "Emphasis", "value": "emphasis" },
        { "title": "Contrast", "value": "contrast" }
      ],
      "visibleWhen": { "all": [
        { "id": "theme", "operation": "!=", "value": "inherit" },
        { "id": "theme", "operation": "notContains", "value": "token:" }
      ] }
    },
    {
      "type": "slider",
      "id": "opacity",
      "label": "Opacity",
      "responsive": false,
      "minimum": 0,
      "maximum": 100,
      "step": 10,
      "editableValue": true,
      "defaults": { "xs": 100 },
      "visibleWhen": { "id": "theme", "operation": "!=", "value": "inherit" }
    }
  ]
}

{
  "controls": [
    {
      "defaults": {
        "base": false
      },
      "id": "itemEnabled",
      "label": "Enable",
      "responsive": true,
      "type": "toggle"
    },
    {
      "defaults": {
        "base": 0
      },
      "id": "flexGrow",
      "label": "Grow",
      "maximum": 10,
      "minimum": 0,
      "responsive": true,
      "step": 1,
      "tooltip": "Flex parent: share remaining space. Zero keeps the natural size.",
      "type": "number",
      "visibleWhen": {
        "id": "itemEnabled",
        "value": true
      }
    },
    {
      "defaults": {
        "base": 1
      },
      "id": "flexShrink",
      "label": "Shrink",
      "maximum": 10,
      "minimum": 0,
      "responsive": true,
      "step": 1,
      "tooltip": "Flex parent: allow this item to shrink. Zero prevents shrinking.",
      "type": "number",
      "visibleWhen": {
        "id": "itemEnabled",
        "value": true
      }
    },
    {
      "defaults": {
        "base": "auto"
      },
      "id": "alignSelf",
      "label": "Alignment",
      "options": [
        {
          "title": "Follow parent",
          "value": "auto"
        },
        {
          "title": "Stretch",
          "value": "stretch"
        },
        {
          "title": "Start",
          "value": "flex-start"
        },
        {
          "title": "Centre",
          "value": "center"
        },
        {
          "title": "End",
          "value": "flex-end"
        },
        {
          "title": "Baseline",
          "value": "baseline"
        }
      ],
      "responsive": true,
      "type": "select",
      "visibleWhen": {
        "id": "itemEnabled",
        "value": true
      }
    },
    {
      "defaults": {
        "base": 1
      },
      "id": "columnSpan",
      "label": "Column span",
      "maximum": 12,
      "minimum": 1,
      "responsive": true,
      "step": 1,
      "tooltip": "Grid parent only. Keep within the parent's column count at this breakpoint.",
      "type": "number",
      "visibleWhen": {
        "id": "itemEnabled",
        "value": true
      }
    },
    {
      "defaults": {
        "base": 1
      },
      "id": "rowSpan",
      "label": "Row span",
      "maximum": 12,
      "minimum": 1,
      "responsive": true,
      "step": 1,
      "tooltip": "Grid parent only.",
      "type": "number",
      "visibleWhen": {
        "id": "itemEnabled",
        "value": true
      }
    }
  ],
  "name": "Layout item",
  "systemImage": "square.on.square",
  "type": "layoutItem"
}

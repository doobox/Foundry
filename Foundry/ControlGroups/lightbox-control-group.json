{
  "type": "lightbox",
  "name": "Lightbox",
  "systemImage": "rectangle.on.rectangle",
  "controls": [
    {
      "type": "toggle",
      "id": "enabled",
      "label": "Enable",
      "presentation": "switch",
      "defaults": {
        "xs": false
      }
    },
    {
      "type": "color",
      "id": "backdropColor",
      "label": "Backdrop",
      "opacity": true,
      "defaults": {
        "xs": "#00000080"
      },
      "visibleWhen": {
        "id": "enabled",
        "value": true
      }
    },
    {
      "type": "number",
      "id": "backdropBlur",
      "label": "Blur",
      "units": "px",
      "minimum": 0,
      "maximum": 40,
      "step": 1,
      "defaults": {
        "xs": 0
      },
      "visibleWhen": {
        "id": "enabled",
        "value": true
      }
    }
  ]
}

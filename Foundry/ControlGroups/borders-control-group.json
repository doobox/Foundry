{
  "type": "borders",
  "name": "Bootstrap borders",
  "systemImage": "square.dashed",
  "controls": [
    {
      "type": "borderSides",
      "id": "sides",
      "label": "Sides",
      "responsive": false,
      "defaults": {
        "base": "none"
      }
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "responsive": false,
      "defaults": {
        "base": "none"
      },
      "options": [
        {
          "title": "Inherit",
          "value": "none"
        },
        {
          "title": "border-keyline",
          "value": "border-keyline"
        },
        {
          "title": "border-1",
          "value": "border-1"
        },
        {
          "title": "border-2",
          "value": "border-2"
        },
        {
          "title": "border-3",
          "value": "border-3"
        },
        {
          "title": "border-4",
          "value": "border-4"
        },
        {
          "title": "border-5",
          "value": "border-5"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "responsive": false,
      "defaults": {
        "base": "inherit"
      },
      "options": [
        {
          "title": "Inherit",
          "value": "inherit"
        },
        {
          "title": "solid",
          "value": "solid"
        },
        {
          "title": "dashed",
          "value": "dashed"
        },
        {
          "title": "dotted",
          "value": "dotted"
        },
        {
          "title": "double",
          "value": "double"
        },
        {
          "title": "none",
          "value": "none"
        },
        {
          "title": "hidden",
          "value": "hidden"
        },
        {
          "title": "groove",
          "value": "groove"
        },
        {
          "title": "ridge",
          "value": "ridge"
        },
        {
          "title": "inset",
          "value": "inset"
        },
        {
          "title": "outset",
          "value": "outset"
        }
      ]
    },
    {
      "type": "select",
      "id": "radius",
      "label": "Radius",
      "responsive": false,
      "defaults": {
        "base": "none"
      },
      "options": [
        {
          "title": "Inherit",
          "value": "none"
        },
        {
          "title": "rounded",
          "value": "rounded"
        },
        {
          "title": "rounded-0",
          "value": "rounded-0"
        },
        {
          "title": "rounded-1",
          "value": "rounded-1"
        },
        {
          "title": "rounded-2",
          "value": "rounded-2"
        },
        {
          "title": "rounded-3",
          "value": "rounded-3"
        },
        {
          "title": "rounded-4",
          "value": "rounded-4"
        },
        {
          "title": "rounded-5",
          "value": "rounded-5"
        },
        {
          "title": "rounded-6",
          "value": "rounded-6"
        },
        {
          "title": "rounded-7",
          "value": "rounded-7"
        },
        {
          "title": "rounded-8",
          "value": "rounded-8"
        },
        {
          "title": "rounded-9",
          "value": "rounded-9"
        },
        {
          "title": "rounded-circle",
          "value": "rounded-circle"
        },
        {
          "title": "rounded-pill",
          "value": "rounded-pill"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "colourEnabled",
      "label": "Border colour",
      "defaults": {
        "base": false
      }
    },
    {
      "type": "themeColor",
      "id": "theme",
      "label": "Colour",
      "defaults": {
        "base": "framework.primary"
      },
      "visibleWhen": {
        "id": "colourEnabled",
        "value": true
      }
    },
    {
      "type": "toggle",
      "id": "subtle",
      "label": "Subtle colour",
      "defaults": {
        "base": false
      },
      "visibleWhen": {
        "id": "colourEnabled",
        "value": true
      }
    }
  ]
}

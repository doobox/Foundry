{
  "controls": [
    {
      "defaults": {
        "base": "full"
      },
      "id": "widthMode",
      "label": "Width",
      "options": [
        {
          "title": "Fill parent",
          "value": "full"
        },
        {
          "title": "Fit content",
          "value": "auto"
        },
        {
          "title": "Custom",
          "value": "custom"
        }
      ],
      "responsive": true,
      "type": "select"
    },
    {
      "defaults": {
        "base": 320
      },
      "id": "customWidth",
      "label": "Custom width",
      "maximum": 10000,
      "minimum": 0,
      "responsive": true,
      "step": 1,
      "type": "number",
      "units": "px",
      "visibleWhen": {
        "id": "widthMode",
        "value": "custom"
      }
    },
    {
      "defaults": {
        "base": 0
      },
      "id": "maxWidth",
      "label": "Maximum width",
      "maximum": 10000,
      "minimum": 0,
      "responsive": true,
      "step": 1,
      "tooltip": "Zero removes the width limit. Never exceeds the available parent width.",
      "type": "number",
      "units": "px"
    },
    {
      "defaults": {
        "base": 0
      },
      "id": "minimumHeight",
      "label": "Minimum height",
      "maximum": 10000,
      "minimum": 0,
      "responsive": true,
      "step": 1,
      "type": "number",
      "units": "px"
    },
    {
      "defaults": {
        "base": "auto"
      },
      "id": "heightMode",
      "label": "Height",
      "options": [
        {
          "title": "Fit content",
          "value": "auto"
        },
        {
          "title": "Fill Remaining Space",
          "value": "fill"
        },
        {
          "title": "Fill viewport",
          "value": "viewport"
        },
        {
          "title": "Custom",
          "value": "custom"
        }
      ],
      "responsive": true,
      "type": "select"
    },
    {
      "defaults": {
        "base": 400
      },
      "id": "customHeight",
      "label": "Custom height",
      "maximum": 10000,
      "minimum": 0,
      "responsive": true,
      "step": 1,
      "type": "number",
      "units": "px",
      "visibleWhen": {
        "id": "heightMode",
        "value": "custom"
      }
    }
  ],
  "name": "Sizing",
  "systemImage": "arrow.up.left.and.arrow.down.right",
  "type": "sizing"
}

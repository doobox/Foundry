{
  "controls": [
    {
      "defaults": {
        "base": "auto"
      },
      "id": "widthMode",
      "label": "Width",
      "options": [
        {
          "title": "Auto",
          "value": "auto"
        },
        {
          "title": "Fill parent",
          "value": "full"
        },
        {
          "title": "Fit content",
          "value": "fit"
        },
        {
          "title": "Viewport",
          "value": "screen"
        },
        {
          "title": "Framework container",
          "value": "breakpoint"
        },
        {
          "title": "Custom",
          "value": "custom"
        }
      ],
      "responsive": true,
      "type": "select"
    },
    {
      "defaults": {
        "base": 320
      },
      "id": "customWidth",
      "label": "Custom width",
      "maximum": 10000,
      "minimum": 0,
      "responsive": true,
      "step": 1,
      "type": "number",
      "units": "px",
      "valueAvailability": "whenVisible",
      "visibleWhen": {
        "id": "widthMode",
        "value": "custom"
      }
    },
    {
      "defaults": {
        "base": "auto"
      },
      "id": "heightMode",
      "label": "Height",
      "tooltip": "Fill remaining space grows along the parent's flex direction: vertically in a column, horizontally in a row. It has no effect outside a flex layout.",
      "options": [
        {
          "title": "Fit content",
          "value": "auto"
        },
        {
          "title": "Fill remaining space",
          "value": "fill"
        },
        {
          "title": "At least viewport height",
          "value": "viewport"
        },
        {
          "title": "Custom",
          "value": "custom"
        }
      ],
      "responsive": true,
      "type": "select"
    },
    {
      "defaults": {
        "base": 400
      },
      "id": "customHeight",
      "label": "Custom height",
      "maximum": 10000,
      "minimum": 0,
      "responsive": true,
      "step": 1,
      "type": "number",
      "units": "px",
      "valueAvailability": "whenVisible",
      "visibleWhen": {
        "id": "heightMode",
        "value": "custom"
      }
    },
    {
      "defaults": {
        "base": "none"
      },
      "id": "aspectRatio",
      "label": "Aspect ratio",
      "tooltip": "Fixes the shape of the part while its width changes. Available when Height is Fit content.",
      "options": [
        {
          "title": "None",
          "value": "none"
        },
        {
          "title": "Square 1:1",
          "value": "1 / 1"
        },
        {
          "title": "4:3",
          "value": "4 / 3"
        },
        {
          "title": "3:2",
          "value": "3 / 2"
        },
        {
          "title": "16:9",
          "value": "16 / 9"
        },
        {
          "title": "21:9",
          "value": "21 / 9"
        },
        {
          "title": "Custom",
          "value": "custom"
        }
      ],
      "responsive": true,
      "type": "select",
      "visibleWhen": {
        "id": "heightMode",
        "value": "auto"
      }
    },
    {
      "defaults": {
        "base": 4
      },
      "id": "aspectRatioWidth",
      "label": "Ratio width",
      "maximum": 1000,
      "minimum": 1,
      "responsive": true,
      "step": 1,
      "type": "number",
      "valueAvailability": "whenVisible",
      "visibleWhen": {
        "all": [
          {
            "id": "heightMode",
            "value": "auto"
          },
          {
            "id": "aspectRatio",
            "value": "custom"
          }
        ]
      }
    },
    {
      "defaults": {
        "base": 3
      },
      "id": "aspectRatioHeight",
      "label": "Ratio height",
      "maximum": 1000,
      "minimum": 1,
      "responsive": true,
      "step": 1,
      "type": "number",
      "valueAvailability": "whenVisible",
      "visibleWhen": {
        "all": [
          {
            "id": "heightMode",
            "value": "auto"
          },
          {
            "id": "aspectRatio",
            "value": "custom"
          }
        ]
      }
    },
    {
      "defaults": {
        "base": "none"
      },
      "id": "minWidth",
      "label": "Min width",
      "noneValue": "0",
      "responsive": true,
      "tooltip": "None leaves it unconstrained.",
      "type": "frameworkSpacing"
    },
    {
      "defaults": {
        "base": "none"
      },
      "id": "maxWidth",
      "label": "Max width",
      "noneValue": "none",
      "responsive": true,
      "tooltip": "Limits the chosen width without enlarging it. None removes this additional limit; the width mode still applies.",
      "type": "frameworkSpacing"
    },
    {
      "defaults": {
        "base": "none"
      },
      "id": "minHeight",
      "label": "Min height",
      "noneValue": "0",
      "responsive": true,
      "tooltip": "None leaves it unconstrained.",
      "type": "frameworkSpacing"
    },
    {
      "defaults": {
        "base": "none"
      },
      "id": "maxHeight",
      "label": "Max height",
      "noneValue": "none",
      "responsive": true,
      "tooltip": "None removes the limit.",
      "type": "frameworkSpacing"
    }
  ],
  "name": "Sizing",
  "systemImage": "arrow.up.left.and.arrow.down.right",
  "type": "sizing"
}

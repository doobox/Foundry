      "maximum": 100,
      "step": 1,
      "units": "px",
      "responsive": true,
      "visibleWhen": {
        "any": [
          {
            "id": "filtersMode",
            "value": "static"
          },
          {
            "all": [
              {
                "id": "filtersMode",

  "controls": [
    {
      "id": "filtersMode",
      "label": "Type",
      "type": "select",
      "presentation": "segmented",
      "responsive": false,
      "defaults": {
        "base": "none"
      },
      "options": [
        {
          "title": "None",
          "value": "none"
        },
        {
          "title": "Static",
          "value": "static"
        },
        {
          "title": "Hover",
          "value": "hover"
        }
      ]
    },
    {
      "id": "filtersState",
      "label": "State",
      "type": "select",
      "presentation": "segmented",
      "responsive": false,
      "defaults": {
        "base": "normal"

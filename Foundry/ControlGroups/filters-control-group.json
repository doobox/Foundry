      "options": [
        {
          "title": "Normal",
          "value": "normal"
        },
        {
          "title": "Hovered",
          "value": "hover"
        }
      ],
      "visibleWhen": {
        "id": "filtersMode",
        "value": "hover"
      }
    },
    {
      "id": "filtersBlur",

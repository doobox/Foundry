{
  "assets": [],
  "author": "Foundry",
  "description": "A four-edge border width editor with framework tokens or custom lengths, and an optional style picker.",
  "group": "Framework",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-border-control.html",
  "icon": {
    "symbol": "rectangle.dashed",
    "tint": "green"
  },
  "id": "foundry.showcase.framework-border",
  "inspector": [
    {
      "section": "Widths",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "frameworkBorder",
          "id": "border",
          "label": "Border",
          "defaults": {
            "base": {
              "width": "sm"
            }
          },
          "tooltip": "The default form: defaults.base.width is one token shared by all four edges; the Style row is hidden but style still returns solid."
        }
      ]
    },
    {
      "section": "With style",
      "systemImage": "rectangle.dashed",
      "controls": [
        {
          "type": "frameworkBorder",
          "id": "frame",
          "label": "Frame",
          "showsStyle": true,
          "defaults": {
            "base": {
              "width": "md",
              "style": "dashed"
            }
          },
          "tooltip": "showsStyle: true adds the Style row; defaults.base.style is any CSS border-style keyword."
        }
      ]
    },
    {
      "section": "Per edge",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "frameworkBorder",
          "id": "rule",
          "label": "Rule",
          "defaults": {
            "base": {
              "width": {
                "top": "none",
                "right": "none",
                "bottom": {
                  "value": 3,
                  "unit": "px"
                },
                "left": "lg"
              }
            }
          },
          "tooltip": "defaults.base.width as four edges, mixing none, a token and a custom { value, unit } length; differing edges start unlinked."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkBorder",
          "id": "outline",
          "label": "Outline",
          "showsStyle": true,
          "responsive": true,
          "defaults": {
            "base": {
              "width": "xs",
              "style": "solid"
            },
            "medium": {
              "width": "lg",
              "style": "double"
            }
          },
          "tooltip": "responsive: true — widths and the Style row override per breakpoint; medium starts thicker and double."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Border",
  "version": "1.0.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "Arranges an element's immediate children in a row or column, with wrapping, gaps and alignment.",
  "group": "Control Groups",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/flexbox-control-group.html",
  "icon": {
    "symbol": "rectangle.3.group",
    "tint": "indigo"
  },
  "id": "foundry.showcase.flexbox",
  "inspector": [
    {
      "section": "Flexbox",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "display",
          "id": "display",
          "defaults": {
            "display": "d-flex"
          }
        },
        {
          "type": "flexbox",
          "id": "flexbox"
        },
        {
          "type": "alignment",
          "id": "alignment",
          "excludeControls": [
            "justifyItems",
            "placeItems"
          ]
        },
        {
          "type": "gap",
          "id": "gap"
        }
      ]
    },
    {
      "section": "Row-first, no reverse",
      "systemImage": "rectangle.split.3x1",
      "controls": [
        {
          "type": "note",
          "body": "allowedOptions limits Direction to flex-row and flex-column; defaults starts it as a wrapping row. The alignment group omits grid-only choices."
        },
        {
          "type": "flexbox",
          "id": "toolbar",
          "allowedOptions": {
            "direction": [
              "flex-row",
              "flex-column"
            ]
          },
          "defaults": {
            "direction": "flex-row",
            "wrap": "flex-wrap"
          }
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Flexbox group",
  "version": "3.0.0",
  "libraries": [
    {
      "id": "bootstrap",
      "majorVersion": 6
    }
  ]
}

{
  "assets": [],
  "author": "Foundry",
  "description": "A framework shadow picker with an optional author-editable stack of outer or inset layers.",
  "group": "Framework",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-shadow-control.html",
  "icon": {
    "symbol": "square.fill.on.square",
    "tint": "blue"
  },
  "id": "foundry.showcase.framework-shadow",
  "inspector": [
    {
      "section": "Framework shadow",
      "systemImage": "square.fill.on.square",
      "controls": [
        {
          "type": "frameworkShadow",
          "id": "cardShadow",
          "label": "Shadow",
          "defaults": {
            "base": "md"
          },
          "tooltip": "defaults.base is a predefined shadow ID: none, inner, xs, sm, md, lg, xl or 2xl."
        }
      ]
    },
    {
      "section": "Custom layers",
      "systemImage": "shippingbox",
      "controls": [
        {
          "type": "frameworkShadow",
          "id": "liftShadow",
          "label": "Lift",
          "allowsCustom": true,
          "defaults": {
            "base": "lg"
          },
          "tooltip": "allowsCustom: true adds the framework-mode toggle; this one starts on the lg token."
        },
        {
          "type": "frameworkShadow",
          "id": "glowShadow",
          "label": "Glow",
          "allowsCustom": true,
          "defaults": {
            "base": "custom"
          },
          "tooltip": "defaults.base: custom (valid only with allowsCustom) starts in the layer editor with Foundry's initial layer."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkShadow",
          "id": "heroShadow",
          "label": "Hero",
          "responsive": true,
          "defaults": {
            "base": "sm",
            "medium": "2xl"
          },
          "tooltip": "responsive: true — base is the phone shadow; medium and wider start at 2xl."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Shadow",
  "version": "1.0.0"
}

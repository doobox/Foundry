{
  "assets": [],
  "author": "Foundry",
  "description": "One font control with coordinated family, weight, style and size rows, returning a structured value.",
  "group": "Framework",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-font-control.html",
  "icon": {
    "symbol": "textformat",
    "tint": "indigo"
  },
  "id": "foundry.showcase.framework-font",
  "inspector": [
    {
      "section": "Family",
      "systemImage": "textformat",
      "controls": [
        {
          "type": "frameworkFont",
          "id": "bodyFont",
          "label": "Font",
          "defaults": {
            "base": "body"
          },
          "tooltip": "The default form: only the family row. defaults.base as a role string is shorthand for { family }."
        }
      ]
    },
    {
      "section": "Weight and style",
      "systemImage": "bold.italic.underline",
      "controls": [
        {
          "type": "frameworkFont",
          "id": "titleFont",
          "label": "Title",
          "showsWeight": true,
          "showsStyle": true,
          "defaults": {
            "base": {
              "family": "heading",
              "weight": 700,
              "style": "normal"
            }
          },
          "tooltip": "showsWeight and showsStyle add rows; defaults.base.weight and defaults.base.style require them."
        }
      ]
    },
    {
      "section": "Size",
      "systemImage": "textformat.size",
      "controls": [
        {
          "type": "frameworkFont",
          "id": "captionFont",
          "label": "Caption",
          "showsSize": true,
          "defaults": {
            "base": {
              "family": "body",
              "size": "sm"
            }
          },
          "tooltip": "showsSize adds the framework size row; defaults.base.size is a predefined size ID and brings its paired lineHeight."
        }
      ]
    },
    {
      "section": "Fixed family",
      "systemImage": "lock",
      "controls": [
        {
          "type": "frameworkFont",
          "id": "codeFont",
          "label": "Code",
          "showsFamily": false,
          "showsWeight": true,
          "defaults": {
            "base": {
              "family": "monospaced",
              "weight": 400
            }
          },
          "tooltip": "showsFamily: false — the family is fixed to the default but still returned; only Weight is editable."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkFont",
          "id": "heroFont",
          "label": "Hero",
          "showsWeight": true,
          "showsStyle": true,
          "showsSize": true,
          "responsive": true,
          "defaults": {
            "base": {
              "family": "heading",
              "weight": 600,
              "style": "normal",
              "size": "2xl"
            },
            "medium": {
              "family": "heading",
              "weight": 800,
              "style": "italic",
              "size": "4xl"
            }
          },
          "tooltip": "responsive: true — each exposed row overrides independently per breakpoint; medium starts heavier, italic and larger."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Font",
  "version": "1.0.0"
}

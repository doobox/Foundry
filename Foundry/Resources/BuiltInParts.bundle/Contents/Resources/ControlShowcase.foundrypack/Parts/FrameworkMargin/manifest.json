{
  "assets": [],
  "author": "Foundry",
  "description": "Four-edge margin from the framework's spacing scale, with none, auto, negative custom lengths and responsive values.",
  "group": "Spacing & Edges",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-margin-control.html",
  "icon": {
    "symbol": "square.on.square.dashed",
    "tint": "orange"
  },
  "id": "foundry.showcase.framework-margin",
  "inspector": [
    {
      "section": "Shared token",
      "systemImage": "link",
      "controls": [
        {
          "type": "frameworkMargin",
          "id": "margin",
          "label": "Margin",
          "defaults": {
            "base": "sm"
          },
          "tooltip": "defaults.base as one framework token applied to all four edges; both pairs start linked."
        }
      ]
    },
    {
      "section": "Per edge with auto",
      "systemImage": "arrow.right.to.line",
      "controls": [
        {
          "type": "frameworkMargin",
          "id": "offset",
          "label": "Offset",
          "subtitle": "Token, none, custom and auto",
          "defaults": {
            "base": {
              "top": "sm",
              "right": "none",
              "bottom": {
                "value": 0.5,
                "unit": "rem"
              },
              "left": "auto"
            }
          },
          "tooltip": "defaults.base as a four-edge dictionary mixing a token, none, a custom length and auto; subtitle beneath the editor."
        }
      ]
    },
    {
      "section": "Negative custom",
      "systemImage": "arrow.up.to.line",
      "controls": [
        {
          "type": "frameworkMargin",
          "id": "pull",
          "label": "Pull up",
          "defaults": {
            "base": {
              "top": {
                "value": -12,
                "unit": "px"
              },
              "right": "none",
              "bottom": "none",
              "left": "none"
            }
          },
          "tooltip": "A negative custom length in defaults.base; margins accept them, padding does not."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkMargin",
          "id": "stackMargin",
          "label": "Stack margin",
          "responsive": true,
          "defaults": {
            "base": "xs",
            "large": "xl"
          },
          "tooltip": "responsive: true with a pinned large breakpoint default; one indicator for all four edges."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Margin",
  "version": "1.0.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "A derived number calculated from constants or other controls, with every operation and rounding.",
  "group": "Text & Numbers",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/math-control.html",
  "icon": {
    "symbol": "function",
    "tint": "blue"
  },
  "id": "foundry.showcase.math",
  "inspector": [
    {
      "section": "Constants",
      "systemImage": "number.square",
      "controls": [
        {
          "type": "math",
          "id": "doubleWidth",
          "subtitle": "24 × 2 — argument1 and argument2 are numbers",
          "argument1": 24,
          "argument2": 2,
          "operation": "*",
          "tooltip": "argument1, argument2 and operation with two numeric constants. No defaults: the value is always derived."
        },
        {
          "type": "math",
          "id": "thirds",
          "subtitle": "100 ÷ \"3\" with round: false — a numeric String argument",
          "argument1": 100,
          "argument2": "3",
          "operation": "/",
          "round": false,
          "tooltip": "argument2 as a numeric String, and round: false to keep the fraction."
        }
      ]
    },
    {
      "section": "From controls",
      "systemImage": "arrow.triangle.branch",
      "controls": [
        {
          "type": "number",
          "id": "total",
          "label": "Total",
          "minimum": 0,
          "maximum": 999,
          "step": 1,
          "defaults": {
            "base": 100
          },
          "tooltip": "A number control read by the math controls below through its id."
        },
        {
          "type": "number",
          "id": "parts",
          "label": "Parts",
          "minimum": 1,
          "maximum": 12,
          "step": 1,
          "defaults": {
            "base": 3
          },
          "tooltip": "The divisor; its maximum also lets the demo loop over it."
        },
        {
          "type": "math",
          "id": "share",
          "subtitle": "total ÷ parts, rounded (the default)",
          "argument1": "total",
          "argument2": "parts",
          "operation": "/",
          "tooltip": "argument1 and argument2 name other controls by id; round defaults to true."
        },
        {
          "type": "math",
          "id": "preciseShare",
          "subtitle": "total ÷ parts with round: false",
          "argument1": "total",
          "argument2": "parts",
          "operation": "/",
          "round": false,
          "tooltip": "round: false keeps the fractional result."
        },
        {
          "type": "math",
          "id": "remainder",
          "subtitle": "total % parts",
          "argument1": "total",
          "argument2": "parts",
          "operation": "%",
          "tooltip": "operation: % — the remainder; dividing by zero returns 0."
        },
        {
          "type": "math",
          "id": "sum",
          "subtitle": "total + parts",
          "argument1": "total",
          "argument2": "parts",
          "operation": "+",
          "tooltip": "operation: +"
        },
        {
          "type": "math",
          "id": "difference",
          "subtitle": "total − parts",
          "argument1": "total",
          "argument2": "parts",
          "operation": "-",
          "tooltip": "operation: -"
        },
        {
          "type": "math",
          "id": "halfShare",
          "subtitle": "share ÷ 2 — one math feeding another",
          "argument1": "share",
          "argument2": 2,
          "operation": "/",
          "round": false,
          "tooltip": "argument1 names another math control; derived values resolve in turn."
        }
      ]
    },
    {
      "section": "Min and max",
      "systemImage": "arrow.up.and.down",
      "controls": [
        {
          "type": "number",
          "id": "level",
          "label": "Level",
          "minimum": 0,
          "maximum": 100,
          "step": 5,
          "units": "%",
          "defaults": {
            "base": 65
          },
          "tooltip": "A number control clamped by the two math controls below."
        },
        {
          "type": "math",
          "id": "atLeast",
          "subtitle": "max(level, 25)",
          "argument1": "level",
          "argument2": 25,
          "operation": "max",
          "tooltip": "operation: max — never lower than 25."
        },
        {
          "type": "math",
          "id": "atMost",
          "subtitle": "min(level, 75)",
          "argument1": "level",
          "argument2": 75,
          "operation": "min",
          "tooltip": "operation: min — never higher than 75."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Math",
  "version": "1.0.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "A numeric field with bounds, a step, a unit label, breakpoint values or a small array.",
  "group": "Text & Numbers",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/number-control.html",
  "icon": {
    "symbol": "number",
    "tint": "blue"
  },
  "id": "foundry.showcase.number",
  "inspector": [
    {
      "section": "Bounds and units",
      "systemImage": "ruler",
      "controls": [
        {
          "type": "number",
          "id": "size",
          "label": "Size",
          "minimum": 16,
          "maximum": 160,
          "step": 8,
          "units": "px",
          "defaults": {
            "base": 64
          },
          "tooltip": "minimum, maximum, step and an Inspector-only units label. The template gets the bare number."
        }
      ]
    },
    {
      "section": "Decimal step",
      "systemImage": "circle.lefthalf.filled",
      "controls": [
        {
          "type": "number",
          "id": "opacity",
          "label": "Opacity",
          "minimum": 0,
          "maximum": 1,
          "step": 0.1,
          "defaults": {
            "base": 0.7
          },
          "tooltip": "step: 0.1 — values are Doubles, so fractional steps are fine."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "number",
          "id": "columns",
          "label": "Columns",
          "minimum": 1,
          "maximum": 6,
          "step": 1,
          "responsive": true,
          "defaults": {
            "base": 2,
            "medium": 4
          },
          "tooltip": "responsive: true — a different number per breakpoint; medium starts at 4. A finite maximum also lets a loop use it."
        }
      ]
    },
    {
      "section": "Count",
      "systemImage": "list.number",
      "controls": [
        {
          "type": "number",
          "id": "insets",
          "label": "Insets",
          "count": 2,
          "subtitle": [
            "Vertical",
            "Horizontal"
          ],
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "units": [
            "px",
            "%"
          ],
          "defaults": {
            "base": [
              12,
              20
            ]
          },
          "tooltip": "count: 2 — two fields stored as one array; units and subtitle take one entry each."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Number",
  "version": "1.0.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "A palette and shade selector that resolves to a light/dark-aware CSS colour, with optional literal colour mode.",
  "group": "Colour",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-colour-control.html",
  "icon": {
    "symbol": "swatchpalette",
    "tint": "purple"
  },
  "id": "foundry.showcase.framework-color",
  "inspector": [
    {
      "section": "Palette",
      "systemImage": "swatchpalette",
      "controls": [
        {
          "type": "frameworkColor",
          "id": "fill",
          "label": "Fill",
          "defaults": {
            "base": {
              "palette": "accent"
            }
          },
          "tooltip": "defaults.base.palette — a framework role; its light and dark default shades are captured when the part is created."
        }
      ]
    },
    {
      "section": "Shades",
      "systemImage": "sun.max",
      "controls": [
        {
          "type": "frameworkColor",
          "id": "band",
          "label": "Band",
          "defaults": {
            "base": {
              "palette": "standard.lime",
              "lightShade": 8,
              "darkShade": 3
            }
          },
          "tooltip": "A standard.* palette ID with defaults.base.lightShade and defaults.base.darkShade fixing the initial shade per appearance."
        }
      ]
    },
    {
      "section": "Custom colour",
      "systemImage": "shippingbox",
      "controls": [
        {
          "type": "frameworkColor",
          "id": "glow",
          "label": "Glow",
          "allowsCustom": true,
          "customColor": "#3366CC",
          "opacity": true,
          "defaults": {
            "base": {
              "palette": "custom"
            }
          },
          "tooltip": "allowsCustom adds the mode button; palette: custom starts in literal mode using customColor; opacity allows alpha on the literal colour."
        }
      ]
    },
    {
      "section": "Output format",
      "systemImage": "textformat.abc",
      "controls": [
        {
          "type": "frameworkColor",
          "id": "ink",
          "label": "Ink",
          "outputFormat": "hsl",
          "defaults": {
            "base": {
              "palette": "text"
            }
          },
          "tooltip": "outputFormat: hsl — only complete-colour formats (hex, rgb, rgba, hsl, hsla) are accepted."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkColor",
          "id": "surface",
          "label": "Surface",
          "responsive": true,
          "defaults": {
            "base": {
              "palette": "surface"
            },
            "medium": {
              "palette": "brand"
            }
          },
          "tooltip": "responsive: true — base is the phone selection; medium and wider start on the brand palette."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Color",
  "version": "1.0.0"
}

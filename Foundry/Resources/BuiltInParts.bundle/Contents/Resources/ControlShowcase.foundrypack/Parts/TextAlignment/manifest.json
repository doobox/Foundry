{
  "assets": [],
  "author": "Foundry",
  "description": "A preset segmented picker for logical text alignment: start, center, end or justify.",
  "group": "Choices",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/text-alignment.html",
  "icon": {
    "symbol": "text.aligncenter",
    "tint": "green"
  },
  "id": "foundry.showcase.text-alignment",
  "inspector": [
    {
      "section": "Alignment",
      "systemImage": "text.alignleft",
      "controls": [
        {
          "type": "textAlignment",
          "id": "alignment",
          "label": "Paragraph",
          "defaults": {
            "base": "start"
          },
          "responsive": false,
          "tooltip": "The default form. defaults.base is one of start, center, end or justify; the template gets that CSS keyword."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "textAlignment",
          "id": "headingAlignment",
          "label": "Heading",
          "defaults": {
            "base": "center",
            "medium": "start"
          },
          "responsive": true,
          "tooltip": "responsive: true — a different alignment per breakpoint; centred on narrow screens, start from medium up."
        }
      ]
    },
    {
      "section": "Count",
      "systemImage": "list.number",
      "controls": [
        {
          "type": "textAlignment",
          "id": "columns",
          "label": "Columns",
          "count": 2,
          "subtitle": [
            "Left column",
            "Right column"
          ],
          "defaults": {
            "base": [
              "start",
              "end"
            ]
          },
          "responsive": false,
          "tooltip": "count: 2 — two pickers stored as one array, with a subtitle each."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Text Alignment",
  "version": "1.0.0"
}

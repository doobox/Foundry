{
  "assets": [],
  "author": "Foundry",
  "description": "A framework shadow and an opacity percentage, composed into box-shadow and opacity.",
  "group": "Control Groups",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/effects-control-group.html",
  "icon": {
    "symbol": "sparkles",
    "tint": "pink"
  },
  "id": "foundry.showcase.effects",
  "inspector": [
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Opacity only",
      "systemImage": "circle.lefthalf.filled",
      "controls": [
        {
          "type": "note",
          "body": "excludeControls: [\"frameworkShadow\"] removes the shadow control, so the composed CSS is opacity alone. defaults starts it enabled at 60%."
        },
        {
          "type": "effects",
          "id": "fade",
          "excludeControls": [
            "frameworkShadow"
          ],
          "defaults": {
            "effectsEnabled": true,
            "opacity": 60
          }
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Effects group",
  "version": "1.0.0"
}

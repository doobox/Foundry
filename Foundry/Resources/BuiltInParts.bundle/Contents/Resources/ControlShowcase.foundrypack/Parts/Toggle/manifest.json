{
  "assets": [],
  "author": "Foundry",
  "description": "A Boolean switch, as a checkbox, a switch, or a small array.",
  "group": "Choices",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/toggle-control.html",
  "icon": {
    "symbol": "switch.2",
    "tint": "green"
  },
  "id": "foundry.showcase.toggle",
  "inspector": [
    {
      "section": "Checkbox",
      "systemImage": "checkmark.square",
      "controls": [
        {
          "type": "toggle",
          "id": "featured",
          "label": "Featured",
          "defaults": {
            "base": false
          },
          "tooltip": "The default presentation: a checkbox."
        }
      ]
    },
    {
      "section": "Switch",
      "systemImage": "switch.2",
      "controls": [
        {
          "type": "toggle",
          "id": "darkMode",
          "label": "Dark mode",
          "presentation": "switch",
          "defaults": {
            "base": true
          },
          "tooltip": "presentation: switch — the value is the same Boolean."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "toggle",
          "id": "showsSidebar",
          "label": "Sidebar",
          "responsive": true,
          "defaults": {
            "base": true,
            "medium": false
          },
          "tooltip": "responsive: true — a different value per breakpoint; medium and wider start off."
        }
      ]
    },
    {
      "section": "Count",
      "systemImage": "list.number",
      "controls": [
        {
          "type": "toggle",
          "id": "days",
          "label": "Open",
          "count": 3,
          "subtitle": [
            "Mon",
            "Wed",
            "Fri"
          ],
          "defaults": {
            "base": [
              true,
              false,
              true
            ]
          },
          "tooltip": "count: 3 — three checkboxes stored as one array."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Toggle",
  "version": "1.0.0"
}

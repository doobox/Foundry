{
  "assets": [],
  "author": "Foundry",
  "description": "Four raw per-corner lengths with your own units and all-or-none linking; no framework tokens.",
  "group": "Spacing & Edges",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/corners-control.html",
  "icon": {
    "symbol": "rectangle.roundedbottom",
    "tint": "teal"
  },
  "id": "foundry.showcase.corners",
  "inspector": [
    {
      "section": "Shared length",
      "systemImage": "link",
      "controls": [
        {
          "type": "corners",
          "id": "radius",
          "label": "Radius",
          "defaults": {
            "base": {
              "value": 8,
              "unit": "px"
            }
          },
          "tooltip": "defaults.base as one { value, unit } length for all four corners; the ring starts linked."
        }
      ]
    },
    {
      "section": "Per corner",
      "systemImage": "square.grid.2x2",
      "controls": [
        {
          "type": "corners",
          "id": "cardRadius",
          "label": "Card radius",
          "subtitle": "Starts unlinked",
          "defaults": {
            "base": {
              "topLeft": {
                "value": 24,
                "unit": "px"
              },
              "topRight": {
                "value": 0,
                "unit": "px"
              },
              "bottomRight": {
                "value": 24,
                "unit": "px"
              },
              "bottomLeft": {
                "value": 0,
                "unit": "px"
              }
            }
          },
          "tooltip": "defaults.base as a four-corner dictionary of lengths; differing corners infer unlinked. subtitle beneath the editor."
        }
      ]
    },
    {
      "section": "Units and responsive",
      "systemImage": "ruler",
      "controls": [
        {
          "type": "corners",
          "id": "clipRadius",
          "label": "Clip radius",
          "units": [
            "%",
            "px"
          ],
          "responsive": true,
          "defaults": {
            "base": {
              "value": 50,
              "unit": "%"
            },
            "large": {
              "value": 24,
              "unit": "px"
            }
          },
          "tooltip": "units restricts the unit menu to % and px; responsive: true with a pinned large default."
        }
      ]
    },
    {
      "section": "Linked",
      "systemImage": "link.badge.plus",
      "controls": [
        {
          "type": "corners",
          "id": "maskRadius",
          "label": "Mask radius",
          "linked": false,
          "defaults": {
            "base": {
              "value": 12,
              "unit": "px"
            }
          },
          "tooltip": "linked: false starts equal defaults with the ring unlinked."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Corners",
  "version": "1.0.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "Four-edge padding from the framework's spacing scale, per edge or shared, with a custom-length mode.",
  "group": "Spacing & Edges",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-padding-control.html",
  "icon": {
    "symbol": "square.dashed.inset.filled",
    "tint": "orange"
  },
  "id": "foundry.showcase.framework-padding",
  "inspector": [
    {
      "section": "Shared token",
      "systemImage": "link",
      "controls": [
        {
          "type": "frameworkPadding",
          "id": "padding",
          "label": "Padding",
          "defaults": {
            "base": "sm"
          },
          "tooltip": "defaults.base as one framework token applied to all four edges; both pairs start linked."
        }
      ]
    },
    {
      "section": "Per edge",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "frameworkPadding",
          "id": "inset",
          "label": "Inset",
          "subtitle": "Token, none and a custom length",
          "defaults": {
            "base": {
              "top": "lg",
              "right": "none",
              "bottom": "lg",
              "left": {
                "value": 1.5,
                "unit": "rem"
              }
            }
          },
          "tooltip": "defaults.base as a four-edge dictionary mixing a token, none and a custom length; subtitle beneath the editor."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkPadding",
          "id": "sectionPadding",
          "label": "Section padding",
          "responsive": true,
          "defaults": {
            "base": "xs",
            "large": "2xl"
          },
          "tooltip": "responsive: true with a pinned large breakpoint default; one indicator for all four edges."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Padding",
  "version": "1.0.0"
}

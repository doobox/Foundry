{
  "assets": [],
  "author": "Foundry",
  "description": "A picker of the project's page folders, for folder-scoped menus, link lists and footers.",
  "group": "Media & Links",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/page-folder-control.html",
  "icon": {
    "symbol": "folder",
    "tint": "cyan"
  },
  "id": "foundry.showcase.page-folder",
  "inspector": [
    {
      "section": "Basic",
      "systemImage": "folder",
      "controls": [
        {
          "type": "pageFolder",
          "id": "sourceFolder",
          "label": "Folder",
          "subtitle": "One of the project's page folders",
          "defaults": {
            "base": ""
          },
          "tooltip": "label, subtitle and defaults.base \"\" — folders belong to the project, so the default is always empty."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "pageFolder",
          "id": "menuFolder",
          "label": "Menu folder",
          "responsive": true,
          "defaults": {
            "base": ""
          },
          "tooltip": "responsive: true — a different folder per breakpoint, for a shorter phone menu."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Page Folder",
  "version": "1.0.0"
}

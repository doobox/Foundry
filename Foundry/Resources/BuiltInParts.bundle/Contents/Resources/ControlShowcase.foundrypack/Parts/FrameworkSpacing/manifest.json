{
  "assets": [],
  "author": "Foundry",
  "description": "One framework spacing value: a token, a custom length, responsive, or with a custom CSS for none.",
  "group": "Spacing & Edges",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-spacing-control.html",
  "icon": {
    "symbol": "arrow.left.and.right",
    "tint": "orange"
  },
  "id": "foundry.showcase.framework-spacing",
  "inspector": [
    {
      "section": "Token",
      "systemImage": "square.grid.3x3",
      "controls": [
        {
          "type": "frameworkSpacing",
          "id": "gap",
          "label": "Gap",
          "defaults": {
            "base": "sm"
          },
          "tooltip": "defaults.base as a framework spacing token (sm)."
        }
      ]
    },
    {
      "section": "Custom length",
      "systemImage": "ruler",
      "controls": [
        {
          "type": "frameworkSpacing",
          "id": "rowGap",
          "label": "Row gap",
          "subtitle": "Starts in custom mode",
          "defaults": {
            "base": {
              "value": 1.5,
              "unit": "rem"
            }
          },
          "tooltip": "defaults.base as a custom length dictionary (value + unit); subtitle beneath the control."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkSpacing",
          "id": "stackGap",
          "label": "Stack gap",
          "responsive": true,
          "defaults": {
            "base": "xs",
            "large": "xl"
          },
          "tooltip": "responsive: true with a pinned large breakpoint default."
        }
      ]
    },
    {
      "section": "None value",
      "systemImage": "nosign",
      "controls": [
        {
          "type": "frameworkSpacing",
          "id": "maxWidth",
          "label": "Max width",
          "noneValue": "none",
          "defaults": {
            "base": "none"
          },
          "tooltip": "noneValue: the CSS emitted for the none token (here none instead of 0)."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Spacing",
  "version": "1.0.0"
}

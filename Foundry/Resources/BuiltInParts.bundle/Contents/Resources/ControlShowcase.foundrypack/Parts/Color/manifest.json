{
  "assets": [],
  "author": "Foundry",
  "description": "A literal colour picker, with opacity, output formats, responsive values and small arrays.",
  "group": "Colour",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/colour.html",
  "icon": {
    "symbol": "paintpalette",
    "tint": "orange"
  },
  "id": "foundry.showcase.color",
  "inspector": [
    {
      "section": "Basic",
      "systemImage": "paintpalette",
      "controls": [
        {
          "type": "color",
          "id": "textColor",
          "label": "Text colour",
          "defaults": {
            "base": "#3366CC"
          },
          "tooltip": "The default form: defaults.base is #RRGGBB and the template receives hex."
        }
      ]
    },
    {
      "section": "Opacity",
      "systemImage": "circle.lefthalf.filled",
      "controls": [
        {
          "type": "color",
          "id": "tint",
          "label": "Tint",
          "opacity": true,
          "defaults": {
            "base": "#FF336680"
          },
          "tooltip": "opacity: true — alpha is allowed and defaults.base may be #RRGGBBAA."
        }
      ]
    },
    {
      "section": "Output format",
      "systemImage": "textformat.abc",
      "controls": [
        {
          "type": "color",
          "id": "brandRGB",
          "label": "RGB values",
          "outputFormat": "rgbValues",
          "defaults": {
            "base": "#0D6EFD"
          },
          "tooltip": "outputFormat: rgbValues — returns 13, 110, 253 for embedding in rgba()."
        },
        {
          "type": "color",
          "id": "brandHSL",
          "label": "HSL",
          "outputFormat": "hsl",
          "defaults": {
            "base": "#0D6EFD"
          },
          "tooltip": "outputFormat: hsl — returns a complete hsl(…) colour."
        },
        {
          "type": "color",
          "id": "brandHex",
          "label": "Hex value",
          "outputFormat": "hexValue",
          "defaults": {
            "base": "#0D6EFD"
          },
          "tooltip": "outputFormat: hexValue — the six hex digits without the #."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "color",
          "id": "accent",
          "label": "Accent",
          "responsive": true,
          "defaults": {
            "base": "#0D6EFD",
            "medium": "#10B981"
          },
          "tooltip": "responsive: true — base is the phone colour; medium and wider start green."
        }
      ]
    },
    {
      "section": "Count",
      "systemImage": "list.number",
      "controls": [
        {
          "type": "color",
          "id": "palette",
          "label": "Palette",
          "count": 3,
          "subtitle": [
            "Primary",
            "Secondary",
            "Tertiary"
          ],
          "defaults": {
            "base": [
              "#0D6EFD",
              "#6610F2",
              "#D63384"
            ]
          },
          "tooltip": "count: 3 — three pickers stored as one array; subtitle captions each."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Color",
  "version": "1.0.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "A picker of the framework's font sizes that resolves the size and its paired line height.",
  "group": "Framework",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-font-size-control.html",
  "icon": {
    "symbol": "textformat.size",
    "tint": "teal"
  },
  "id": "foundry.showcase.framework-font-size",
  "inspector": [
    {
      "section": "Basic",
      "systemImage": "textformat.size",
      "controls": [
        {
          "type": "frameworkFontSize",
          "id": "textSize",
          "label": "Size",
          "defaults": {
            "base": "base"
          },
          "tooltip": "defaults.base is a predefined size ID; base is the framework's body size, shown as MD."
        }
      ]
    },
    {
      "section": "Scale",
      "systemImage": "textformat.size.larger",
      "controls": [
        {
          "type": "frameworkFontSize",
          "id": "fineSize",
          "label": "Fine print",
          "defaults": {
            "base": "xs"
          },
          "tooltip": "defaults.base: xs — the smallest predefined size."
        },
        {
          "type": "frameworkFontSize",
          "id": "displaySize",
          "label": "Display",
          "defaults": {
            "base": "5xl"
          },
          "tooltip": "defaults.base: 5xl — IDs run xs, sm, base, lg, xl, then 2xl through 9xl."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkFontSize",
          "id": "headingSize",
          "label": "Heading",
          "responsive": true,
          "defaults": {
            "base": "2xl",
            "medium": "4xl"
          },
          "tooltip": "responsive: true — base is the phone size; medium and wider start at 4xl."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Font Size",
  "version": "1.0.0"
}

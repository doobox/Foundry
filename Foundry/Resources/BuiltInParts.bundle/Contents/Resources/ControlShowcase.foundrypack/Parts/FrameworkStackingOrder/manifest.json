{
  "assets": [],
  "author": "Foundry",
  "description": "A picker of the framework's stacking-order tokens, or a custom number, that resolves to a z-index.",
  "group": "Framework",
  "helpURL": "https://doobox.github.io/foundry-docs/developer/framework-stacking-order-control.html",
  "icon": {
    "symbol": "square.3.layers.3d",
    "tint": "gray"
  },
  "id": "foundry.showcase.framework-stacking-order",
  "inspector": [
    {
      "section": "Token",
      "systemImage": "square.3.layers.3d",
      "controls": [
        {
          "type": "frameworkStackingOrder",
          "id": "frontLayer",
          "label": "Blue card",
          "defaults": {
            "base": "overlay"
          },
          "tooltip": "defaults.base is a predefined stacking ID. The mode button switches to a custom integer."
        },
        {
          "type": "frameworkStackingOrder",
          "id": "backLayer",
          "label": "Amber card",
          "defaults": {
            "base": "base"
          },
          "tooltip": "defaults.base: base — the lowest token. Raise it above the blue card to swap the layering."
        }
      ]
    },
    {
      "section": "Responsive",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "frameworkStackingOrder",
          "id": "badgeLayer",
          "label": "Badge",
          "responsive": true,
          "defaults": {
            "base": "toast",
            "medium": "base"
          },
          "tooltip": "responsive: true — base is the phone selection (toast, on top); medium and wider start at base, behind the panel."
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "showsInPartLibrary": false,
  "tags": [
    "Foundry",
    "showcase"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Framework Stacking Order",
  "version": "1.0.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "Adds a visual rule between groups of content.",
  "group": "Content",
  "icon": {
    "symbol": "minus",
    "tint": "gray"
  },
  "id": "foundry.content.divider",
  "inspector": [
    {
      "controls": [
        {
          "allowsCustom": true,
          "customColor": "#D9D9DE",
          "defaults": {
            "base": {
              "palette": "custom"
            }
          },
          "id": "borderColor",
          "label": "Colour",
          "opacity": true,
          "responsive": true,
          "type": "frameworkColor"
        },
        {
          "defaults": {
            "base": 1
          },
          "id": "borderWidth",
          "label": "Thickness",
          "maximum": 24,
          "minimum": 1,
          "responsive": true,
          "step": 1,
          "type": "number",
          "units": "px"
        }
      ],
      "section": "Appearance",
      "systemImage": "paintpalette"
    },
    {
      "controls": [
        {
          "defaultOverrides": {
            "frameworkMargin": {
              "bottom": "md",
              "left": "none",
              "right": "none",
              "top": "md"
            }
          },
          "type": "spacing"
        }
      ],
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right"
    },
    {
      "controls": [
        {
          "type": "reveal"
        }
      ],
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "separator"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Divider",
  "version": "1.1.0"
}

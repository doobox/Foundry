{
  "assets": [],
  "author": "Foundry",
  "description": "Adds a visual rule between groups of content.",
  "group": "Content",
  "id": "foundry.content.divider",
  "inspector": [
    {
      "controls": [
        {
          "allowsCustom": true,
          "customColor": "#D9D9DE",
          "defaults": {
            "base": {
              "palette": "custom"
            }
          },
          "id": "borderColor",
          "label": "Colour",
          "opacity": true,
          "responsive": true,
          "type": "frameworkColor"
        },
        {
          "defaults": {
            "base": 1
          },
          "id": "borderWidth",
          "label": "Thickness",
          "maximum": 24,
          "minimum": 1,
          "responsive": true,
          "step": 1,
          "type": "number",
          "units": "px"
        }
      ],
      "section": "Appearance",
      "systemImage": "paintpalette"
    },
    {
      "defaultOverrides": {
        "frameworkMargin": {
          "bottom": "md",
          "left": "none",
          "right": "none",
          "top": "md"
        }
      },
      "type": "spacing"
    },
    {
      "type": "reveal"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "separator"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Divider",
  "version": "1.0.0"
}

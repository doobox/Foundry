{
  "assets": [],
  "author": "Foundry",
  "description": "Content and placement settings for one item directly inside Grid.",
  "group": "Layout",
  "icon": {
    "symbol": "square.stack.3d.up",
    "tint": "indigo"
  },
  "id": "foundry.layout.griditem",
  "inspector": [
    {
      "section": "Grid Item",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "number",
          "id": "columnSpan",
          "label": "Columns Wide",
          "defaults": {
            "base": 1
          },
          "minimum": 1,
          "maximum": 12,
          "step": 1,
          "responsive": true,
          "tooltip": "Keep this within the Grid's column count at each breakpoint; a wider span adds extra columns and can overflow small screens."
        },
        {
          "type": "number",
          "id": "rowSpan",
          "label": "Rows Tall",
          "defaults": {
            "base": 1
          },
          "minimum": 1,
          "maximum": 12,
          "step": 1,
          "responsive": true,
          "tooltip": "The number of rows this item covers."
        },
        {
          "type": "number",
          "id": "columnStart",
          "label": "Start Column",
          "defaults": {
            "base": 0
          },
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "0 places the item automatically. Positive numbers select a grid line."
        },
        {
          "type": "number",
          "id": "rowStart",
          "label": "Start Row",
          "defaults": {
            "base": 0
          },
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "0 places the item automatically. Positive numbers select a grid line."
        },
        {
          "type": "select",
          "id": "gridAlign",
          "label": "Item vertical alignment",
          "defaults": {
            "base": "stretch"
          },
          "responsive": true,
          "options": [
            {
              "value": "auto",
              "title": "Auto"
            },
            {
              "value": "start",
              "title": "Start"
            },
            {
              "value": "center",
              "title": "Centre"
            },
            {
              "value": "end",
              "title": "End"
            },
            {
              "value": "stretch",
              "title": "Stretch"
            }
          ],
          "tooltip": "Positions the whole item within its grid cell. Stretch fills the available height unless Sizing sets a height. Auto follows the Grid. Use Content alignment to position what is inside."
        },
        {
          "type": "select",
          "id": "gridJustify",
          "label": "Item horizontal alignment",
          "defaults": {
            "base": "stretch"
          },
          "responsive": true,
          "options": [
            {
              "value": "auto",
              "title": "Auto"
            },
            {
              "value": "start",
              "title": "Start"
            },
            {
              "value": "center",
              "title": "Centre"
            },
            {
              "value": "end",
              "title": "End"
            },
            {
              "value": "stretch",
              "title": "Stretch"
            }
          ],
          "tooltip": "Positions the whole item within its grid cell. Stretch fills the available width unless Sizing sets a width. Auto follows the Grid."
        },
        {
          "type": "number",
          "id": "itemOrder",
          "label": "Order",
          "defaults": {
            "base": 0
          },
          "minimum": -100,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "Changes visual order only, not reading or keyboard order. Prefer rearranging parts in the tree."
        },
        {
          "type": "divider"
        },
        {
          "type": "frameworkSpacing",
          "id": "contentGap",
          "label": "Content Gap",
          "defaults": {
            "base": "none"
          },
          "noneValue": "0px",
          "responsive": true
        },
        {
          "type": "select",
          "id": "contentAlignment",
          "label": "Content alignment",
          "defaults": { "base": "flex-start" },
          "responsive": true,
          "options": [
            { "value": "flex-start", "title": "Top" },
            { "value": "center", "title": "Centre" },
            { "value": "flex-end", "title": "Bottom" }
          ],
          "tooltip": "Positions the content vertically inside this item without changing the item's size. Leave Item vertical alignment on Stretch to fill the grid cell."
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "allowedOptions": {
            "heightMode": [
              "auto",
              "viewport",
              "custom"
            ]
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "image",
            "gradient",
            "video"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Shadow",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          }
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "section": "Link",
      "systemImage": "link",
      "controls": [
        {
          "type": "linkOverlay",
          "id": "link"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "grid",
    "item"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Grid Item",
  "version": "1.2.0",
  "showsInPartLibrary": false,
  "allowedParents": [
    "foundry.layout.grid"
  ]
}

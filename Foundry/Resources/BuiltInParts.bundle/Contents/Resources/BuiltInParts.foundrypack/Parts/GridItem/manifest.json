{
  "assets": [],
  "author": "Foundry",
  "description": "Content and placement settings for one item directly inside Grid.",
  "group": "Layout",
  "icon": {
    "symbol": "square.stack.3d.up",
    "tint": "indigo"
  },
  "id": "foundry.layout.griditem",
  "inspector": [
    {
      "section": "Grid Item",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "number",
          "id": "columnSpan",
          "label": "Columns Wide",
          "defaults": {
            "base": 1
          },
          "minimum": 1,
          "maximum": 12,
          "step": 1,
          "responsive": true,
          "tooltip": "Keep this within the Grid's column count at each breakpoint; a wider span adds extra columns and can overflow small screens."
        },
        {
          "type": "number",
          "id": "rowSpan",
          "label": "Rows Tall",
          "defaults": {
            "base": 1
          },
          "minimum": 1,
          "maximum": 12,
          "step": 1,
          "responsive": true,
          "tooltip": "The number of rows this item covers."
        },
        {
          "type": "number",
          "id": "columnStart",
          "label": "Start Column",
          "defaults": {
            "base": 0
          },
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "0 places the item automatically. Positive numbers select a grid line."
        },
        {
          "type": "number",
          "id": "rowStart",
          "label": "Start Row",
          "defaults": {
            "base": 0
          },
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "0 places the item automatically. Positive numbers select a grid line."
        },
        {
          "type": "select",
          "id": "gridAlign",
          "label": "Align Vertically",
          "defaults": {
            "base": "auto"
          },
          "responsive": true,
          "options": [
            {
              "value": "auto",
              "title": "Auto"
            },
            {
              "value": "start",
              "title": "Start"
            },
            {
              "value": "center",
              "title": "Centre"
            },
            {
              "value": "end",
              "title": "End"
            },
            {
              "value": "stretch",
              "title": "Stretch"
            }
          ],
          "tooltip": "Auto follows the Grid's alignment."
        },
        {
          "type": "select",
          "id": "gridJustify",
          "label": "Align Horizontally",
          "defaults": {
            "base": "auto"
          },
          "responsive": true,
          "options": [
            {
              "value": "auto",
              "title": "Auto"
            },
            {
              "value": "start",
              "title": "Start"
            },
            {
              "value": "center",
              "title": "Centre"
            },
            {
              "value": "end",
              "title": "End"
            },
            {
              "value": "stretch",
              "title": "Stretch"
            }
          ],
          "tooltip": "Auto follows the Grid's alignment."
        },
        {
          "type": "number",
          "id": "itemOrder",
          "label": "Order",
          "defaults": {
            "base": 0
          },
          "minimum": -100,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "Changes visual order only, not reading or keyboard order. Prefer rearranging parts in the tree."
        }
      ]
    },
    {
      "section": "Content",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "frameworkSpacing",
          "id": "contentGap",
          "label": "Gap",
          "defaults": {
            "base": "none"
          },
          "noneValue": "0px",
          "responsive": true
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "allowedOptions": {
            "heightMode": [
              "auto",
              "viewport",
              "custom"
            ]
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background"
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          },
          "id": "layout"
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "destination",
          "label": "Destination",
          "tooltip": "Makes the whole part one link. The overlay also covers links and buttons inside; avoid nesting interactive content when enabled.",
          "type": "link"
        },
        {
          "defaults": {
            "base": ""
          },
          "id": "linkLabel",
          "label": "Accessible name",
          "tooltip": "Describes the destination for screen readers, which cannot see the part's contents.",
          "type": "text",
          "visibleWhen": {
            "id": "destination",
            "operation": "isNotEmpty"
          }
        }
      ],
      "section": "Link",
      "systemImage": "link"
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "grid",
    "item"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Grid Item",
  "version": "1.0.0",
  "showsInPartLibrary": false,
  "allowedParents": [
    "foundry.layout.grid"
  ]
}

{
  "assets": [],
  "author": "Foundry",
  "description": "The site menu. Lists pages marked Include in Navigation, highlights the current page, shows child pages in dropdowns, and collapses to a menu button on small screens.",
  "group": "Navigation",
  "id": "foundry.layout.navigation",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": true
          },
          "id": "showBrand",
          "label": "Show Brand",
          "tooltip": "Shows the brand name and optional logo, linking to the home page.",
          "type": "toggle"
        },
        {
          "id": "brandLogo",
          "label": "Logo",
          "type": "image",
          "visibleWhen": {
            "id": "showBrand",
            "value": true
          }
        },
        {
          "defaults": {
            "base": 28
          },
          "id": "logoHeight",
          "label": "Logo Height",
          "maximum": 96,
          "minimum": 12,
          "step": 1,
          "type": "number",
          "visibleWhen": {
            "id": "showBrand",
            "value": true
          }
        }
      ],
      "section": "Brand",
      "systemImage": "house"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "site"
          },
          "id": "source",
          "label": "Source",
          "options": [
            {
              "title": "Site Navigation",
              "value": "site"
            },
            {
              "title": "Top Level Only",
              "value": "topLevel"
            },
            {
              "title": "Folder",
              "value": "folder"
            }
          ],
          "tooltip": "What this menu lists: the site navigation, its top level only, or one folder's contents.",
          "type": "select"
        },
        {
          "defaults": {
            "base": ""
          },
          "id": "sourceFolder",
          "label": "Folder",
          "tooltip": "The folder whose contents this menu lists.",
          "type": "pageFolder",
          "visibleWhen": {
            "id": "source",
            "value": "folder"
          }
        },
        {
          "defaults": {
            "base": true
          },
          "id": "showDropdowns",
          "label": "Dropdown Menus",
          "tooltip": "Shows child pages in a dropdown under their parent.",
          "type": "toggle"
        },
        {
          "defaults": {
            "base": "end"
          },
          "id": "menuAlignment",
          "label": "Align Links",
          "options": [
            {
              "title": "Start",
              "value": "start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "end"
            }
          ],
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": "base"
          },
          "id": "fontSize",
          "label": "Text Size",
          "responsive": true,
          "type": "frameworkFontSize"
        },
        {
          "allowsCustom": true,
          "customColor": "#000000",
          "defaults": {
            "base": {
              "palette": "text"
            }
          },
          "id": "linkColor",
          "label": "Link Colour",
          "opacity": true,
          "responsive": true,
          "type": "frameworkColor"
        },
        {
          "allowsCustom": true,
          "customColor": "#0000EE",
          "defaults": {
            "base": {
              "palette": "links"
            }
          },
          "id": "activeColor",
          "label": "Active Colour",
          "opacity": true,
          "responsive": true,
          "tooltip": "Colours the current page's link, ancestors and hovered links.",
          "type": "frameworkColor"
        }
      ],
      "section": "Menu",
      "systemImage": "list.bullet"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "767"
          },
          "id": "collapseAt",
          "label": "Collapse Menu",
          "options": [
            {
              "title": "Never",
              "value": "0"
            },
            {
              "title": "Below 480 px",
              "value": "479"
            },
            {
              "title": "Below 768 px",
              "value": "767"
            },
            {
              "title": "Below 992 px",
              "value": "991"
            },
            {
              "title": "Always",
              "value": "99999"
            }
          ],
          "tooltip": "The width below which links collapse behind a menu button.",
          "type": "select"
        },
        {
          "defaults": {
            "base": false
          },
          "id": "sticky",
          "label": "Pin to Top",
          "tooltip": "Keeps the navigation visible while the page scrolls.",
          "type": "toggle"
        }
      ],
      "section": "Behaviour",
      "systemImage": "pin"
    },
    {
      "defaultOverrides": {
        "frameworkPadding": {
          "bottom": "2xs",
          "left": "sm",
          "right": "sm",
          "top": "2xs"
        }
      },
      "type": "spacing"
    },
    {
      "type": "borders"
    },
    {
      "type": "effects"
    },
    {
      "type": "background"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "navigation",
    "menu",
    "navbar"
  ],
  "templates": {
    "editorCSS": "editor.css",
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      },
      {
        "path": "part.js",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Navigation",
  "version": "1.0.0"
}

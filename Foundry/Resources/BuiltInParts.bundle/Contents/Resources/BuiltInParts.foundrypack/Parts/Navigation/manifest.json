{
  "assets": [],
  "author": "Foundry",
  "description": "The site menu. Lists pages marked Include in Navigation, highlights the current page, shows child pages in dropdowns, and collapses to a menu button on small screens.",
  "group": "Navigation",
  "icon": {
    "symbol": "inset.filled.topthird.rectangle",
    "tint": "brown.dark"
  },
  "id": "foundry.layout.navigation",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": true
          },
          "id": "showBrand",
          "label": "Show Brand",
          "presentation": "switch",
          "tooltip": "Shows the brand name and optional logo, linking to the home page.",
          "type": "toggle"
        },
        {
          "id": "brandLogo",
          "label": "Logo",
          "type": "image",
          "visibleWhen": {
            "id": "showBrand",
            "value": true
          }
        },
        {
          "defaults": {
            "base": 28
          },
          "id": "logoHeight",
          "label": "Logo Height",
          "maximum": 96,
          "minimum": 12,
          "step": 1,
          "type": "number",
          "visibleWhen": {
            "id": "showBrand",
            "value": true
          }
        }
      ],
      "section": "Brand",
      "systemImage": "house"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "site"
          },
          "id": "source",
          "label": "Source",
          "options": [
            {
              "title": "Site Navigation",
              "value": "site"
            },
            {
              "title": "Top Level Only",
              "value": "topLevel"
            },
            {
              "title": "Folder",
              "value": "folder"
            }
          ],
          "tooltip": "What this menu lists: the site navigation, its top level only, or one folder's contents.",
          "type": "select"
        },
        {
          "defaults": {
            "base": ""
          },
          "id": "sourceFolder",
          "label": "Folder",
          "tooltip": "The folder whose contents this menu lists.",
          "type": "pageFolder",
          "visibleWhen": {
            "id": "source",
            "value": "folder"
          }
        },
        {
          "defaults": {
            "base": true
          },
          "id": "showDropdowns",
          "label": "Dropdown Menus",
          "presentation": "switch",
          "tooltip": "Shows child pages in a dropdown under their parent.",
          "type": "toggle"
        },
        {
          "defaults": {
            "base": false
          },
          "id": "dropdownsOnHover",
          "label": "Open on Hover",
          "presentation": "switch",
          "tooltip": "Opens dropdowns when the pointer hovers their link. Touch screens keep the tap button.",
          "type": "toggle",
          "visibleWhen": {
            "id": "showDropdowns",
            "value": true
          }
        }
      ],
      "section": "Menu",
      "systemImage": "list.bullet"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "contained"
          },
          "id": "contentWidth",
          "label": "Content Width",
          "options": [
            {
              "title": "Contained",
              "value": "contained"
            },
            {
              "title": "Full Width",
              "value": "full"
            }
          ],
          "presentation": "segmented",
          "tooltip": "Contained keeps the bar's content inside the site's content width; Full Width lets it reach the part's edges.",
          "type": "select"
        },
        {
          "defaults": {
            "base": "end"
          },
          "id": "menuAlignment",
          "label": "Align Links",
          "options": [
            {
              "title": "Start",
              "value": "start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "end"
            }
          ],
          "presentation": "segmented",
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": "normal"
          },
          "id": "itemSpacing",
          "label": "Link Spacing",
          "options": [
            {
              "title": "Compact",
              "value": "compact"
            },
            {
              "title": "Normal",
              "value": "normal"
            },
            {
              "title": "Relaxed",
              "value": "relaxed"
            }
          ],
          "presentation": "segmented",
          "responsive": true,
          "type": "select"
        }
      ],
      "section": "Layout",
      "systemImage": "rectangle.3.group"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "plain"
          },
          "id": "linkStyle",
          "label": "Link Style",
          "options": [
            {
              "title": "Plain",
              "value": "plain"
            },
            {
              "title": "Pills",
              "value": "pills"
            },
            {
              "title": "Underline",
              "value": "underline"
            }
          ],
          "presentation": "segmented",
          "tooltip": "Pills fill the current page's link; Underline draws a bar under hovered and current links.",
          "type": "select"
        },
        {
          "defaults": {
            "base": false
          },
          "id": "uppercaseLinks",
          "label": "Capitalise Links",
          "presentation": "switch",
          "tooltip": "Shows menu links in spaced capitals.",
          "type": "toggle"
        },
        {
          "defaults": {
            "base": "base"
          },
          "id": "fontSize",
          "label": "Text Size",
          "responsive": true,
          "type": "frameworkFontSize"
        },
        {
          "allowsCustom": true,
          "customColor": "#000000",
          "defaults": {
            "base": {
              "palette": "text"
            }
          },
          "id": "linkColor",
          "label": "Link Colour",
          "opacity": true,
          "responsive": true,
          "type": "frameworkColor"
        },
        {
          "allowsCustom": true,
          "customColor": "#0000EE",
          "defaults": {
            "base": {
              "palette": "links"
            }
          },
          "id": "activeColor",
          "label": "Active Colour",
          "opacity": true,
          "responsive": true,
          "tooltip": "Colours the current page's link, ancestors and hovered links.",
          "type": "frameworkColor"
        }
      ],
      "section": "Links",
      "systemImage": "character"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "767"
          },
          "id": "collapseAt",
          "label": "Collapse Menu",
          "options": [
            {
              "title": "Never",
              "value": "0"
            },
            {
              "title": "Below 480 px",
              "value": "479"
            },
            {
              "title": "Below 768 px",
              "value": "767"
            },
            {
              "title": "Below 992 px",
              "value": "991"
            },
            {
              "title": "Always",
              "value": "99999"
            }
          ],
          "tooltip": "The width below which links collapse behind a menu button.",
          "type": "select"
        },
        {
          "defaults": {
            "base": false
          },
          "id": "sticky",
          "label": "Pin to Top",
          "presentation": "switch",
          "tooltip": "Keeps the navigation visible while the page scrolls.",
          "type": "toggle"
        }
      ],
      "section": "Behaviour",
      "systemImage": "pin"
    },
    {
      "controls": [
        {
          "defaults": {
            "frameworkPadding": {
              "bottom": "2xs",
              "left": "none",
              "right": "none",
              "top": "2xs"
            }
          },
          "type": "spacing",
          "id": "spacing"
        }
      ],
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right"
    },
    {
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "image",
            "gradient",
            "video"
          ]
        }
      ],
      "section": "Background",
      "systemImage": "paintbrush.fill"
    },
    {
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ],
      "section": "Borders",
      "systemImage": "square.dashed"
    },
    {
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ],
      "section": "Effects",
      "systemImage": "sparkles"
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions",
          "defaults": {
            "transitionsEnabled": true,
            "transitionDuration": 150,
            "transitionFunction": "ease"
          }
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "navigation",
    "menu",
    "navbar"
  ],
  "templates": {
    "editorCSS": "editor.css",
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      },
      {
        "path": "part.js",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Navigation",
  "version": "1.1.0"
}

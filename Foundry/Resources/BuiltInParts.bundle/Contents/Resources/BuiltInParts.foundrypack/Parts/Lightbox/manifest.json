{
  "minimumAPIVersion": 1,
  "id": "foundry.content.lightbox",
  "title": "Lightbox",
  "description": "Open custom content from a button, image or simple card.",
  "author": "Foundry",
  "version": "1.0.0",
  "group": "Content",
  "icon": {
    "symbol": "rectangle.on.rectangle",
    "tint": "purple"
  },
  "tags": [
    "Foundry",
    "built-in",
    "lightbox",
    "modal"
  ],
  "inspector": [
    {
      "section": "Lightbox",
      "systemImage": "rectangle.on.rectangle",
      "controls": [
        {
          "type": "childPicker",
          "id": "trigger",
          "label": "Trigger",
          "buttonText": "Add Trigger",
          "pickerItems": [
            "foundry.content.button",
            "foundry.media.image",
            "foundry.layout.section"
          ],
          "accepts": [
            "*"
          ],
          "initial": [
            "foundry.content.button"
          ],
          "minimum": 0,
          "maximum": 1,
          "containment": "open",
          "tooltip": "One button, image or simple card. Do not put multiple links or form fields in the trigger."
        },
        {
          "type": "childPicker",
          "id": "content",
          "label": "Content",
          "buttonText": "Add Content",
          "pickerItems": [
            "foundry.layout.section"
          ],
          "accepts": [
            "*"
          ],
          "initial": [
            "foundry.layout.section"
          ],
          "minimum": 0,
          "containment": "open"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Accessible title",
          "defaults": {
            "base": "Lightbox"
          }
        },
        {
          "type": "lightbox",
          "id": "lightbox",
          "defaults": {
            "enabled": true
          }
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "defaults": {
            "widthMode": "full"
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "image",
            "gradient",
            "video"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Shadow",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          }
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "templates": {
    "html": "part.html",
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ]
  },
  "assets": []
}

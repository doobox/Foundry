{
  "assets": [],
  "author": "Foundry",
  "description": "Adds a paragraph of body text to the page.",
  "group": "Content",
  "icon": {
    "symbol": "text.alignleft",
    "tint": "orange"
  },
  "id": "foundry.content.paragraph",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": {
              "family": "body",
              "style": "normal",
              "weight": 400
            }
          },
          "id": "font",
          "label": "Font",
          "responsive": true,
          "showsStyle": true,
          "showsWeight": true,
          "type": "frameworkFont"
        },
        {
          "defaults": {
            "base": false
          },
          "id": "sizeEnabled",
          "label": "Custom Size",
          "responsive": true,
          "type": "toggle"
        },
        {
          "defaults": {
            "base": "base"
          },
          "id": "fontSize",
          "label": "Size",
          "responsive": true,
          "type": "frameworkFontSize",
          "visibleWhen": {
            "id": "sizeEnabled",
            "value": true
          }
        },
        {
          "defaults": {
            "base": "start"
          },
          "id": "textAlignment",
          "label": "Alignment",
          "responsive": true,
          "type": "textAlignment"
        },
        {
          "defaults": {
            "base": "none"
          },
          "id": "textDecoration",
          "label": "Underline",
          "options": [
            {
              "title": "No Underline",
              "value": "none"
            },
            {
              "title": "Underline",
              "value": "underline"
            },
            {
              "title": "Overline",
              "value": "overline"
            },
            {
              "title": "Line Through",
              "value": "line-through"
            }
          ],
          "responsive": true,
          "type": "select"
        }
      ],
      "section": "Typography",
      "systemImage": "textformat"
    },
    {
      "controls": [
        {
          "allowsCustom": true,
          "customColor": "#000000",
          "defaults": {
            "base": {
              "palette": "text"
            }
          },
          "id": "textColor",
          "label": "Colour",
          "opacity": true,
          "responsive": true,
          "type": "frameworkColor"
        }
      ],
      "section": "Colour",
      "systemImage": "paintpalette"
    },
    {
      "section": "Content",
      "systemImage": "doc.text"
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "gradient",
            "image"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout"
        }
      ]
    },
    {
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ],
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack"
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Paragraph",
  "version": "1.2.0"
}

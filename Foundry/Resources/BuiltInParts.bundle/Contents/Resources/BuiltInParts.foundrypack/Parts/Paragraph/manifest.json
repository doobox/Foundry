{
  "id": "foundry.content.paragraph",
  "title": "Paragraph",
  "author": "Foundry",
  "version": "3.0.0",
  "minimumAPIVersion": 1,
  "description": "Editable paragraph text using Bootstrap typography and spacing.",
  "group": "Content",
  "icon": {
    "symbol": "text.alignleft",
    "tint": "blue"
  },
  "tags": [
    "Bootstrap",
    "text",
    "paragraph"
  ],
  "assets": [],
  "libraries": [
    {
      "id": "bootstrap",
      "majorVersion": 6
    }
  ],
  "templates": {
    "html": "part.html"
  },
  "inspector": [
    {
      "section": "Content",
      "systemImage": "doc.text"
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Typography",
      "systemImage": "textformat",
      "controls": [
        {
          "type": "typography",
          "id": "typography",
          "excludeControls": [
            "fontSize",
            "lineHeight",
            "verticalAlignment"
          ]
        }
      ]
    },
    {
      "section": "Foreground",
      "systemImage": "paintpalette",
      "controls": [
        {
          "type": "foreground",
          "id": "foreground",
          "colourSections": [
            "foregrounds",
            "blackWhite",
            "themes"
          ]
        }
      ]
    },
    {
      "section": "Links",
      "systemImage": "link",
      "controls": [
        {
          "type": "linkStyling",
          "id": "links",
          "targetSelector": "a[href]:not(.btn)"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ]
}

{
  "assets": [],
  "author": "Foundry",
  "description": "Content and placement settings for one item directly inside Stack.",
  "group": "Layout",
  "icon": {
    "symbol": "square.stack.3d.up",
    "tint": "indigo"
  },
  "id": "foundry.layout.stackitem",
  "inspector": [
    {
      "section": "Stack Item",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "select",
          "id": "flexSize",
          "label": "Size",
          "defaults": {
            "base": "fit"
          },
          "responsive": true,
          "options": [
            {
              "value": "fit",
              "title": "Fit Content"
            },
            {
              "value": "fill",
              "title": "Fill Space"
            },
            {
              "value": "equal",
              "title": "Equal Space"
            },
            {
              "value": "custom",
              "title": "Custom"
            }
          ],
          "tooltip": "Fit Content keeps the item's natural size. Fill Space grows from that size. Equal Space divides the available space evenly along the Stack direction. Custom shows Grow, Shrink and Starting Size."
        },
        {
          "type": "number",
          "id": "flexGrow",
          "label": "Grow",
          "defaults": {
            "base": 0
          },
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "0 keeps the natural size. Higher values share available space.",
          "visibleWhen": {
            "id": "flexSize",
            "value": "custom"
          }
        },
        {
          "type": "number",
          "id": "flexShrink",
          "label": "Shrink",
          "defaults": {
            "base": 1
          },
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "1 allows shrinking when space is tight; 0 prevents it.",
          "visibleWhen": {
            "id": "flexSize",
            "value": "custom"
          }
        },
        {
          "type": "frameworkSpacing",
          "id": "flexBasis",
          "label": "Starting Size",
          "defaults": {
            "base": "none"
          },
          "noneValue": "auto",
          "responsive": true,
          "tooltip": "None uses the natural size. Choose a framework value or custom length.",
          "visibleWhen": {
            "id": "flexSize",
            "value": "custom"
          }
        },
        {
          "type": "select",
          "id": "flexAlign",
          "label": "Item Alignment",
          "defaults": {
            "base": "auto"
          },
          "responsive": true,
          "options": [
            {
              "value": "auto",
              "title": "Auto"
            },
            {
              "value": "flex-start",
              "title": "Start"
            },
            {
              "value": "center",
              "title": "Centre"
            },
            {
              "value": "flex-end",
              "title": "End"
            },
            {
              "value": "stretch",
              "title": "Stretch"
            },
            {
              "value": "baseline",
              "title": "Baseline"
            }
          ],
          "tooltip": "Auto follows the Stack's Item Alignment."
        },
        {
          "type": "number",
          "id": "itemOrder",
          "label": "Order",
          "defaults": {
            "base": 0
          },
          "minimum": -100,
          "maximum": 100,
          "step": 1,
          "responsive": true,
          "tooltip": "Changes visual order only, not reading or keyboard order. Prefer rearranging parts in the tree."
        },
        {
          "type": "divider"
        },
        {
          "type": "frameworkSpacing",
          "id": "contentGap",
          "label": "Content Gap",
          "defaults": {
            "base": "none"
          },
          "noneValue": "0px",
          "responsive": true
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "allowedOptions": {
            "heightMode": [
              "auto",
              "viewport",
              "custom"
            ]
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "image",
            "gradient",
            "video"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Shadow",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          }
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "section": "Link",
      "systemImage": "link",
      "controls": [
        {
          "type": "linkOverlay",
          "id": "link"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "flex",
    "item"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Stack Item",
  "version": "1.0.0",
  "showsInPartLibrary": false,
  "allowedParents": [
    "foundry.layout.stack"
  ]
}

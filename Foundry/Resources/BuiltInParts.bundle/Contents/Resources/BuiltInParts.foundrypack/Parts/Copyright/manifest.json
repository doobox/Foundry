{
  "author": "Foundry",
  "description": "Displays copyright information that automatically stays in sync with the current year.",
  "group": "Content",
  "icon": {
    "symbol": "c.circle",
    "tint": "orange"
  },
  "id": "foundry.content.copyright",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": "©"
          },
          "id": "format",
          "label": "Copyright Mark",
          "options": [
            {
              "title": "©",
              "value": "©"
            },
            {
              "title": "Copyright",
              "value": "Copyright"
            },
            {
              "title": "Copr.",
              "value": "Copr."
            }
          ],
          "type": "select"
        },
        {
          "defaults": {
            "base": "Your Company"
          },
          "id": "holder",
          "label": "Rights holder",
          "type": "text"
        },
        {
          "defaults": {
            "base": 2020
          },
          "id": "start",
          "label": "First Published",
          "maximum": 5000,
          "minimum": 1900,
          "type": "number"
        },
        {
          "defaults": {
            "base": "All rights reserved."
          },
          "id": "append",
          "label": "Append",
          "type": "text"
        }
      ],
      "section": "Copyright Settings",
      "systemImage": "c.circle"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "body"
          },
          "id": "font",
          "responsive": true,
          "showsSize": true,
          "showsStyle": true,
          "showsWeight": true,
          "type": "frameworkFont"
        },
        {
          "defaults": {
            "base": {
              "palette": "text"
            }
          },
          "id": "textColour",
          "label": "Colour",
          "type": "frameworkColor"
        }
      ],
      "section": "Typography",
      "systemImage": "textformat"
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "gradient",
            "image"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Shadow",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout"
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "copyright",
    "footer",
    "year"
  ],
  "templates": {
    "editorCSS": "editor.css",
    "files": [
      {
        "path": "part.css"
      },
      {
        "path": "part.js",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Copyright",
  "version": "1.2.0"
}

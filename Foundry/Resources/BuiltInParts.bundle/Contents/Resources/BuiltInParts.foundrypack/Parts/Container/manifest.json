{
  "assets": [],
  "author": "Foundry",
  "description": "A width-constrained content group with shared spacing and appearance settings.",
  "group": "Layout",
  "id": "foundry.layout.container",
  "inspector": [
    {
      "defaultOverrides": {
        "maxWidth": 1120
      },
      "type": "sizing"
    },
    {
      "defaultOverrides": {
        "itemEnabled": true
      },
      "type": "layoutItem"
    },
    {
      "defaultOverrides": {
        "frameworkMargin": {
          "bottom": "none",
          "left": "auto",
          "right": "auto",
          "top": "none"
        }
      },
      "type": "spacing"
    },
    {
      "defaultOverrides": {
        "borderEnabled": true
      },
      "type": "borders"
    },
    {
      "type": "effects"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "visible"
          },
          "id": "overflow",
          "label": "Overflow",
          "options": [
            {
              "title": "Visible",
              "value": "visible"
            },
            {
              "title": "Clip",
              "value": "hidden"
            },
            {
              "title": "Scroll when needed",
              "value": "auto"
            }
          ],
          "responsive": true,
          "tooltip": "Clipping can hide shadows or focus outlines.",
          "type": "select"
        }
      ],
      "section": "Advanced",
      "systemImage": "gearshape"
    },
    {
      "type": "background"
    },
    {
      "type": "reveal"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "width"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Container",
  "version": "2.0.0"
}

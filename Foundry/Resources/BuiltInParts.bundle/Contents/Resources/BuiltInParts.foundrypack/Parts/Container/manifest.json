{
  "assets": [],
  "author": "Foundry",
  "description": "A page section. Backgrounds, borders and padding span its full width; inside, content stacks like an ordinary block and stays within the site's content width.",
  "group": "Layout",
  "icon": {
    "symbol": "rectangle",
    "tint": "blue"
  },
  "id": "foundry.layout.container",
  "inspector": [
    {
      "section": "Content Layout",
      "systemImage": "rectangle.center.inset.filled",
      "controls": [
        {
          "type": "note",
          "id": "contentSizeHeading",
          "body": "Width"
        },
        {
          "type": "select",
          "id": "contentWidth",
          "label": "Width",
          "defaults": {
            "base": "breakpoint"
          },
          "options": [
            {
              "value": "breakpoint",
              "title": "Breakpoint"
            },
            {
              "value": "full",
              "title": "Full"
            },
            {
              "value": "auto",
              "title": "Fit Content"
            },
            {
              "value": "custom",
              "title": "Custom"
            }
          ],
          "responsive": true,
          "tooltip": "Breakpoint keeps content at the site's content width. Full spans the section. Fit Content shrinks to the content. Custom sets an exact width."
        },
        {
          "type": "frameworkSpacing",
          "id": "contentWidthSpacing",
          "label": "Custom Width",
          "defaults": {
            "base": {
              "value": 60,
              "unit": "rem"
            }
          },
          "noneValue": "auto",
          "responsive": true,
          "visibleWhen": {
            "id": "contentWidth",
            "value": "custom"
          }
        },
        {
          "type": "divider",
          "id": "contentLayoutDivider",
          "visibleWhen": {
            "any": [
              {
                "id": "sizing.heightMode",
                "operation": "!=",
                "value": "auto"
              },
              {
                "id": "sizing.minHeight",
                "operation": "isNotEmpty"
              }
            ]
          }
        },
        {
          "type": "note",
          "id": "contentAlignmentHeading",
          "body": "Position",
          "visibleWhen": {
            "any": [
              {
                "id": "sizing.heightMode",
                "operation": "!=",
                "value": "auto"
              },
              {
                "id": "sizing.minHeight",
                "operation": "isNotEmpty"
              }
            ]
          }
        },
        {
          "type": "select",
          "id": "contentAlignment",
          "label": "Vertical position",
          "defaults": {
            "base": "center"
          },
          "options": [
            {
              "value": "normal",
              "title": "Auto"
            },
            {
              "value": "start",
              "title": "Start"
            },
            {
              "value": "end",
              "title": "End"
            },
            {
              "value": "center",
              "title": "Centre"
            },
            {
              "value": "stretch",
              "title": "Stretch"
            }
          ],
          "responsive": true,
          "tooltip": "Where the content box sits when the section is taller than its content.",
          "visibleWhen": {
            "any": [
              {
                "id": "sizing.heightMode",
                "operation": "!=",
                "value": "auto"
              },
              {
                "id": "sizing.minHeight",
                "operation": "isNotEmpty"
              }
            ]
          }
        },
        {
          "type": "frameworkSpacing",
          "id": "contentGap",
          "label": "Gap",
          "defaults": {
            "base": "none"
          },
          "noneValue": "normal",
          "responsive": true,
          "tooltip": "Space between the parts stacked inside. None uses the normal automatic gap (zero for this layout)."
        }
      ]
    },
    {
      "section": "Content Spacing",
      "systemImage": "rectangle.inset.filled",
      "controls": [
        {
          "type": "note",
          "body": "Margins and padding of the content box inside the section. Auto side margins centre it; set one side to None to push the content that way.",
          "systemImage": "info.circle"
        },
        {
          "type": "spacing",
          "id": "contentSpacing",
          "defaults": {
            "spacingEnabled": true,
            "frameworkMargin": {
              "top": "none",
              "right": "auto",
              "bottom": "none",
              "left": "auto"
            }
          }
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "defaults": {
            "widthMode": "full"
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing",
          "defaults": {
            "spacingEnabled": true,
            "frameworkPadding": {
              "top": "xl",
              "right": "md",
              "bottom": "xl",
              "left": "md"
            }
          }
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background"
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          },
          "id": "layout"
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "destination",
          "label": "Destination",
          "tooltip": "Makes the whole part one link. The overlay also covers links and buttons inside; avoid nesting interactive content when enabled.",
          "type": "link"
        },
        {
          "defaults": {
            "base": ""
          },
          "id": "linkLabel",
          "label": "Accessible name",
          "tooltip": "Describes the destination for screen readers, which cannot see the part's contents.",
          "type": "text",
          "visibleWhen": {
            "id": "destination",
            "operation": "isNotEmpty"
          }
        }
      ],
      "section": "Link",
      "systemImage": "link"
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "section",
    "container"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Container",
  "version": "3.1.0"
}

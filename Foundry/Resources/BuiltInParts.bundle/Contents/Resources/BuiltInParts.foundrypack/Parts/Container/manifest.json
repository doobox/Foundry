{
  "assets": [],
  "author": "Foundry",
  "description": "A full-width section. Backgrounds span its whole width while content stays inside the site's content width by default.",
  "group": "Layout",
  "id": "foundry.layout.container",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": "contained"
          },
          "id": "contentWidth",
          "label": "Content Width",
          "options": [
            {
              "title": "Contained",
              "value": "contained"
            },
            {
              "title": "Full Width",
              "value": "full"
            },
            {
              "title": "Custom",
              "value": "custom"
            }
          ],
          "presentation": "segmented",
          "responsive": true,
          "tooltip": "Contained keeps content inside the site's content width; Full Width lets it reach the container's edges. Backgrounds always span the full container.",
          "type": "select"
        },
        {
          "defaults": {
            "base": 800
          },
          "id": "customContentWidth",
          "label": "Custom Width",
          "maximum": 10000,
          "minimum": 200,
          "responsive": true,
          "step": 10,
          "type": "number",
          "units": "px",
          "visibleWhen": {
            "id": "contentWidth",
            "value": "custom"
          }
        },
        {
          "defaults": {
            "base": 0
          },
          "id": "minimumHeight",
          "label": "Minimum height",
          "maximum": 10000,
          "minimum": 0,
          "responsive": true,
          "step": 1,
          "type": "number",
          "units": "px"
        },
        {
          "defaults": {
            "base": "auto"
          },
          "id": "heightMode",
          "label": "Height",
          "options": [
            {
              "title": "Fit content",
              "value": "auto"
            },
            {
              "title": "Fill Remaining Space",
              "value": "fill"
            },
            {
              "title": "Fill viewport",
              "value": "viewport"
            },
            {
              "title": "Custom",
              "value": "custom"
            }
          ],
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": 400
          },
          "id": "customHeight",
          "label": "Custom height",
          "maximum": 10000,
          "minimum": 0,
          "responsive": true,
          "step": 1,
          "type": "number",
          "units": "px",
          "visibleWhen": {
            "id": "heightMode",
            "value": "custom"
          }
        },
        {
          "defaults": {
            "base": "visible"
          },
          "id": "overflow",
          "label": "Overflow",
          "options": [
            {
              "title": "Visible",
              "value": "visible"
            },
            {
              "title": "Clip",
              "value": "hidden"
            },
            {
              "title": "Scroll when needed",
              "value": "auto"
            }
          ],
          "responsive": true,
          "tooltip": "Clipping can hide shadows or focus outlines.",
          "type": "select"
        }
      ],
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": "flex-start"
          },
          "id": "contentAlignment",
          "label": "Align",
          "options": [
            {
              "title": "Top",
              "value": "flex-start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "Bottom",
              "value": "flex-end"
            },
            {
              "title": "Space Between",
              "value": "space-between"
            }
          ],
          "responsive": true,
          "tooltip": "Where content sits vertically when the container is taller than it.",
          "type": "select"
        },
        {
          "defaults": {
            "base": "stretch"
          },
          "id": "contentJustify",
          "label": "Align Horizontally",
          "options": [
            {
              "title": "Stretch",
              "value": "stretch"
            },
            {
              "title": "Start",
              "value": "flex-start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "flex-end"
            }
          ],
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": "none"
          },
          "id": "contentGap",
          "label": "Gap",
          "responsive": true,
          "tooltip": "Space between the container's direct children.",
          "type": "frameworkSpacing"
        }
      ],
      "section": "Content Layout",
      "systemImage": "rectangle.center.inset.filled"
    },
    {
      "controls": [
        {
          "type": "spacing"
        }
      ],
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right"
    },
    {
      "controls": [
        {
          "type": "background"
        }
      ],
      "section": "Background",
      "systemImage": "paintbrush.fill"
    },
    {
      "controls": [
        {
          "defaultOverrides": {
            "borderEnabled": true
          },
          "type": "borders"
        }
      ],
      "section": "Borders",
      "systemImage": "square.dashed"
    },
    {
      "controls": [
        {
          "type": "effects"
        }
      ],
      "section": "Effects",
      "systemImage": "sparkles"
    },
    {
      "controls": [
        {
          "type": "reveal"
        }
      ],
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "width"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Container",
  "version": "2.3.0"
}

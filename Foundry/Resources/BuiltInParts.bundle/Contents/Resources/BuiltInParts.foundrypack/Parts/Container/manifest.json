{
  "id": "foundry.layout.container",
  "title": "Container",
  "author": "Foundry",
  "version": "3.0.0",
  "minimumAPIVersion": 1,
  "description": "A full-width outer wrapper with Bootstrap page-width content inside.",
  "group": "Layout",
  "icon": {
    "symbol": "rectangle"
  },
  "tags": [
    "Bootstrap",
    "layout",
    "container"
  ],
  "assets": [],
  "templates": {
    "html": "part.html"
  },
  "inspector": [
    {
      "section": "Container",
      "systemImage": "rectangle",
      "controls": []
    },
    {
      "section": "Container content",
      "systemImage": "text.rectangle",
      "controls": [
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "tooltip": "Sets the inner content width. Default follows every Bootstrap breakpoint. Fluid fills the available width. Fluid until a breakpoint follows Bootstrap container widths from that breakpoint upwards. All options retain Bootstrap's horizontal gutters.",
          "responsive": false,
          "defaults": {
            "xs": "container"
          },
          "options": [
            {
              "title": "Default",
              "value": "container"
            },
            {
              "title": "Fluid",
              "value": "container-fluid"
            },
            {
              "title": "Fluid until small (sm)",
              "value": "sm:container"
            },
            {
              "title": "Fluid until medium (md)",
              "value": "md:container"
            },
            {
              "title": "Fluid until large (lg)",
              "value": "lg:container"
            },
            {
              "title": "Fluid until extra large (xl)",
              "value": "xl:container"
            },
            {
              "title": "Fluid until 2× large (2xl)",
              "value": "2xl:container"
            }
          ]
        },
        {
          "type": "space",
          "id": "contentSpacing",
          "label": "Space",
          "tooltip": "Vertical spacing between direct child parts. Inherit leaves their existing margins unchanged.",
          "responsive": true,
          "defaults": {
            "xs": "inherit"
          },
          "axis": "y"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintpalette",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "colourSections": [
            "blackWhite",
            "surfaces",
            "themes"
          ],
          "backgroundTypes": [
            "colour",
            "gradient",
            "image",
            "video"
          ]
        }
      ]
    },
    {
      "type": "advanced"
    }
  ]
}

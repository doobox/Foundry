{
  "assets": [],
  "author": "Foundry",
  "description": "A full-width section. Backgrounds span its whole width while content stays inside the site's content width by default.",
  "group": "Layout",
  "icon": {
    "symbol": "rectangle.inset.filled",
    "tint": "indigo"
  },
  "id": "foundry.layout.container",
  "inspector": [
    {
      "section": "Content Layout",
      "systemImage": "rectangle.center.inset.filled",
      "controls": [
        {
          "defaults": {
            "base": "contained"
          },
          "id": "contentWidth",
          "label": "Width",
          "options": [
            {
              "title": "Site Content Width",
              "value": "contained"
            },
            {
              "title": "Full Width",
              "value": "full"
            },
            {
              "title": "Custom",
              "value": "custom"
            }
          ],
          "responsive": true,
          "tooltip": "Sets the inner content width. The section background still covers the root element.",
          "type": "select"
        },
        {
          "defaults": {
            "base": 800
          },
          "id": "customContentWidth",
          "label": "Custom Width",
          "maximum": 10000,
          "minimum": 200,
          "responsive": true,
          "step": 10,
          "type": "number",
          "units": "px",
          "visibleWhen": {
            "id": "contentWidth",
            "value": "custom"
          }
        },
        {
          "defaults": {
            "base": "flex-start"
          },
          "id": "contentAlignment",
          "label": "Vertical Alignment",
          "options": [
            {
              "title": "Top",
              "value": "flex-start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "Bottom",
              "value": "flex-end"
            },
            {
              "title": "Space Between",
              "value": "space-between"
            }
          ],
          "responsive": true,
          "tooltip": "Where content sits vertically when the container is taller than it.",
          "type": "select"
        },
        {
          "defaults": {
            "base": "stretch"
          },
          "id": "contentJustify",
          "label": "Horizontal Alignment",
          "options": [
            {
              "title": "Stretch",
              "value": "stretch"
            },
            {
              "title": "Start",
              "value": "flex-start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "flex-end"
            }
          ],
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": "none"
          },
          "id": "contentGap",
          "label": "Gap",
          "responsive": true,
          "tooltip": "Space between the container's direct children.",
          "type": "frameworkSpacing"
        }
      ]
    },
    {
      "controls": [
        {
          "excludeControls": [
            "widthMode",
            "customWidth",
            "minWidth",
            "maxWidth"
          ],
          "id": "sizing",
          "type": "sizing"
        }
      ],
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right"
    },
    {
      "controls": [
        {
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          },
          "id": "layout",
          "type": "layout"
        }
      ],
      "section": "Section Layout",
      "systemImage": "square.on.square"
    },
    {
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ],
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right"
    },
    {
      "controls": [
        {
          "type": "background",
          "id": "background"
        }
      ],
      "section": "Background",
      "systemImage": "paintbrush.fill"
    },
    {
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ],
      "section": "Borders",
      "systemImage": "square.dashed"
    },
    {
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ],
      "section": "Effects",
      "systemImage": "sparkles"
    },
    {
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ],
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "width"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Container",
  "version": "2.4.0"
}

{
  "id": "foundry.layout.container",
  "title": "Container",
  "author": "Foundry",
  "version": "3.0.0",
  "minimumAPIVersion": 1,
  "description": "Bootstrap page-width containment and grouping.",
  "group": "Layout",
  "icon": {
    "symbol": "rectangle",
    "tint": "blue"
  },
  "tags": [
    "Bootstrap",
    "layout",
    "container"
  ],
  "assets": [],
  "libraries": [
    {
      "id": "bootstrap",
      "majorVersion": 6
    }
  ],
  "templates": {
    "html": "part.html"
  },
  "inspector": [
    {
      "section": "Container",
      "systemImage": "rectangle",
      "controls": [
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "tooltip": "Default follows every Bootstrap breakpoint. Fluid fills the available width. Fluid until a breakpoint follows Bootstrap container widths from that breakpoint upwards. All options retain Bootstrap's horizontal gutters.",
          "responsive": false,
          "defaults": {
            "base": "container"
          },
          "options": [
            {
              "title": "Default",
              "value": "container"
            },
            {
              "title": "Fluid",
              "value": "container-fluid"
            },
            {
              "title": "Fluid until small (sm)",
              "value": "sm:container"
            },
            {
              "title": "Fluid until medium (md)",
              "value": "md:container"
            },
            {
              "title": "Fluid until large (lg)",
              "value": "lg:container"
            },
            {
              "title": "Fluid until extra large (xl)",
              "value": "xl:container"
            },
            {
              "title": "Fluid until 2× large (2xl)",
              "value": "2xl:container"
            }
          ]
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "id": "sizing",
          "excludeControls": [
            "width",
            "minWidth",
            "maxWidth"
          ]
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Typography",
      "systemImage": "textformat",
      "controls": [
        {
          "type": "typography",
          "id": "typography",
          "excludeControls": [
            "fontSize",
            "fontStyle",
            "lineHeight",
            "textDecoration",
            "textTransform",
            "textWrap",
            "wordWrap",
            "userSelect",
            "verticalAlignment"
          ]
        }
      ]
    },
    {
      "section": "Content typography",
      "systemImage": "doc.text",
      "controls": [
        {
          "type": "prose",
          "id": "prose"
        }
      ]
    },
    {
      "section": "Foreground",
      "systemImage": "paintpalette",
      "controls": [
        {
          "type": "foreground",
          "id": "foreground",
          "colourSections": [
            "foregrounds",
            "blackWhite"
          ]
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintpalette",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "colourSections": [
            "blackWhite",
            "surfaces"
          ],
          "backgroundTypes": [
            "colour",
            "gradient",
            "image",
            "video"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Links",
      "systemImage": "link",
      "controls": [
        {
          "type": "linkStyling",
          "id": "links",
          "targetSelector": "a[href]:not(.btn)"
        }
      ]
    },
    {
      "section": "Display",
      "systemImage": "eye",
      "controls": [
        {
          "type": "display",
          "id": "display",
          "allowedOptions": {
            "display": [
              "none",
              "d-block",
              "d-none"
            ]
          }
        }
      ]
    },
    {
      "type": "advanced"
    }
  ]
}

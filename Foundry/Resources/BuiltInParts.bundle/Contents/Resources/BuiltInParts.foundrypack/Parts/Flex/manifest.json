{
  "assets": [],
  "author": "Foundry",
  "description": "Arranges child parts side by side or stacked with CSS Flexbox — direction, wrapping, distribution and alignment.",
  "group": "Layout",
  "icon": {
    "symbol": "square.dashed",
    "tint": "blue"
  },
  "id": "foundry.layout.flex",
  "inspector": [
    {
      "section": "Flexbox",
      "systemImage": "square.dashed",
      "controls": [
        {
          "defaults": {
            "direction": "row",
            "wrap": "wrap"
          },
          "type": "flexbox",
          "id": "flexbox"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          },
          "id": "layout"
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background"
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "destination",
          "label": "Destination",
          "tooltip": "Makes the whole part clickable. Buttons and links inside keep their own destinations.",
          "type": "link"
        },
        {
          "defaults": {
            "base": ""
          },
          "id": "linkLabel",
          "label": "Accessible name",
          "tooltip": "Describes the destination for screen readers, which cannot see the part's contents.",
          "type": "text",
          "visibleWhen": {
            "id": "destination",
            "operation": "isNotEmpty"
          }
        }
      ],
      "section": "Link",
      "systemImage": "link"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "flex"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Flex",
  "version": "1.1.0"
}

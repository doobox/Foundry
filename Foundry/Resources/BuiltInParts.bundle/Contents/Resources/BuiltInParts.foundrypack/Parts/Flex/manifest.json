{
  "assets": [],
  "author": "Foundry",
  "description": "Arrange content in a responsive row or column, with optional wrapping.",
  "group": "Layout",
  "id": "foundry.layout.flex",
  "icon": {
    "symbol": "app.dashed",
    "tint": "blue"
  },
  "inspector": [
    {
      "section": "Items",
      "systemImage": "square.stack",
      "controls": [
        {
          "type": "childPicker",
          "id": "content",
          "label": "Items",
          "pickerItems": [
            "foundry.layout.flexitem"
          ],
          "accepts": [
            "*"
          ],
          "initial": [
            "foundry.layout.flexitem",
            "foundry.layout.flexitem",
            "foundry.layout.flexitem"
          ],
          "minimum": 0,
          "containment": "open",
          "tooltip": "Drop any part straight into the row. Add a Flex Item when an item needs its own size, background, padding or alignment."
        }
      ]
    },
    {
      "section": "Flex",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "flexbox",
          "id": "flexbox",
          "defaults": {
            "direction": "row",
            "wrap": "wrap",
            "alignItems": "center"
          }
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "defaults": {
            "widthMode": "full"
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background"
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          },
          "id": "layout"
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "destination",
          "label": "Destination",
          "tooltip": "Makes the whole part one link. The overlay also covers links and buttons inside; avoid nesting interactive content when enabled.",
          "type": "link"
        },
        {
          "defaults": {
            "base": ""
          },
          "id": "linkLabel",
          "label": "Accessible name",
          "tooltip": "Describes the destination for screen readers, which cannot see the part's contents.",
          "type": "text",
          "visibleWhen": {
            "id": "destination",
            "operation": "isNotEmpty"
          }
        }
      ],
      "section": "Link",
      "systemImage": "link"
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "flex",
    "row",
    "stack"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Flexbox",
  "version": "2.0.0"
}

{
  "id": "foundry.layout.flex",
  "title": "Flex",
  "author": "Foundry",
  "version": "3.0.0",
  "minimumAPIVersion": 1,
  "description": "Arrange child parts in Bootstrap flex rows or columns.",
  "group": "Layout",
  "icon": {
    "file": "flex.svg"
  },
  "tags": [
    "Bootstrap",
    "layout",
    "flex"
  ],
  "assets": [],
  "templates": {
    "html": "part.html"
  },
  "inspector": [
    {
      "section": "Flex",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "flexbox",
          "id": "flexbox"
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Alignment",
      "systemImage": "align.horizontal.center",
      "controls": [
        {
          "type": "alignment",
          "id": "alignment",
          "excludeControls": [
            "justifyItems",
            "placeItems"
          ]
        }
      ]
    },
    {
      "section": "Gap",
      "systemImage": "arrow.left.and.right",
      "controls": [
        {
          "type": "gap",
          "id": "gap"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Typography",
      "systemImage": "textformat",
      "controls": [
        {
          "type": "typography",
          "id": "typography",
          "excludeControls": [
            "fontSize",
            "fontStyle",
            "lineHeight",
            "textDecoration",
            "textTransform",
            "textWrap",
            "wordWrap",
            "userSelect",
            "verticalAlignment"
          ]
        }
      ]
    },
    {
      "section": "Foreground",
      "systemImage": "paintpalette",
      "controls": [
        {
          "type": "foreground",
          "id": "foreground",
          "colourSections": [
            "foregrounds",
            "blackWhite",
            "themes"
          ]
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintpalette",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "colourSections": [
            "blackWhite",
            "surfaces",
            "themes"
          ],
          "backgroundTypes": [
            "colour",
            "gradient",
            "image"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Links",
      "systemImage": "link",
      "controls": [
        {
          "type": "linkStyling",
          "id": "links",
          "targetSelector": "a[href]:not(.btn)"
        }
      ]
    },
    {
      "section": "Display",
      "systemImage": "eye",
      "controls": [
        {
          "type": "display",
          "id": "display",
          "defaults": {
            "display": "d-flex"
          },
          "allowedOptions": {
            "display": [
              "d-flex",
              "d-none"
            ]
          }
        }
      ]
    },
    {
      "type": "advanced"
    }
  ]
}

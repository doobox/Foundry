{
  "assets": [],
  "author": "Foundry",
  "description": "Five content cells arranged with responsive bento-style presets. Every preset keeps every cell visible.",
  "group": "Layout",
  "icon": {
    "symbol": "app.grid.2x2",
    "tint": "blue"
  },
  "id": "foundry.layout.bento-grid",
  "inspector": [
    {
      "section": "Bento Grid",
      "systemImage": "app.grid.2x2",
      "controls": [
        {
          "type": "select",
          "id": "preset",
          "label": "Layout",
          "options": [
            {
              "value": "stacked",
              "title": "Stacked"
            },
            {
              "value": "feature-left",
              "title": "Feature Left"
            },
            {
              "value": "feature-right",
              "title": "Feature Right"
            },
            {
              "value": "feature-top",
              "title": "Feature Top"
            },
            {
              "value": "feature-bottom",
              "title": "Feature Bottom"
            },
            {
              "value": "balanced",
              "title": "Balanced Mosaic"
            },
            {
              "value": "equal",
              "title": "Five Equal"
            }
          ],
          "defaults": {
            "base": "stacked",
            "medium": "feature-left"
          },
          "responsive": true,
          "tooltip": "The arrangement of the five cells. Every layout uses every cell, so changing presets never hides content."
        },
        {
          "type": "frameworkSpacing",
          "id": "gap",
          "label": "Gap",
          "defaults": {
            "base": "md"
          },
          "responsive": true,
          "tooltip": "The space between cells."
        },
        {
          "type": "number",
          "id": "minimumCellHeight",
          "label": "Minimum Cell Height",
          "units": "px",
          "minimum": 0,
          "maximum": 2000,
          "step": 1,
          "defaults": {
            "base": 160,
            "medium": 220
          },
          "responsive": true,
          "tooltip": "The smallest height of a regular cell. Featured cells may span two rows."
        },
        {
          "type": "select",
          "id": "contentPosition",
          "label": "Content Position",
          "presentation": "segmented",
          "options": [
            {
              "value": "flex-start",
              "title": "Top"
            },
            {
              "value": "center",
              "title": "Centre"
            },
            {
              "value": "flex-end",
              "title": "Bottom"
            }
          ],
          "defaults": {
            "base": "flex-start"
          },
          "responsive": true,
          "tooltip": "Where content sits vertically when a cell has extra height."
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "defaults": {
            "widthMode": "full"
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "image",
            "gradient",
            "video"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Shadow",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          }
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "section": "Link",
      "systemImage": "link",
      "controls": [
        {
          "type": "linkOverlay",
          "id": "link"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "bento",
    "grid",
    "mosaic"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Bento Grid",
  "version": "1.0.0"
}

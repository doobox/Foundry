{
  "id": "foundry.utility.appearance-switcher",
  "title": "Appearance Switcher",
  "author": "Foundry",
  "version": "1.0.0",
  "minimumAPIVersion": 1,
  "description": "A Light, Dark and Auto menu that remembers the visitor’s choice.",
  "group": "Utility",
  "icon": {
    "symbol": "moon.stars"
  },
  "assets": [],
  "templates": {
    "html": "part.html",
    "files": [{ "path": "part.js", "scope": "instance" }]
  },
  "inspector": [{
      "section": "Appearance",
      "systemImage": "paintpalette",
      "controls": [
        { "type": "colourControls", "id": "theme", "include": ["themeColors"] },
        {
          "type": "select",
          "id": "variant",
          "label": "Variant",
          "options": [
            { "title": "Text", "value": "btn-text" },
            { "title": "Solid", "value": "btn-solid" },
            { "title": "Subtle", "value": "btn-subtle" },
            { "title": "Outline", "value": "btn-outline" }
          ],
          "defaults": { "xs": "btn-text" }
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "title": "Small", "value": "btn-sm" },
            { "title": "Default", "value": "" },
            { "title": "Large", "value": "btn-lg" }
          ],
          "defaults": { "xs": "" }
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [{ "type": "spacing", "id": "spacing" }]
    },
    { "type": "advanced" }
  ]
}

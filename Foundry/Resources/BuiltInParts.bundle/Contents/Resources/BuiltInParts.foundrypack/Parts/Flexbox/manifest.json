{
  "assets": [],
  "author": "Foundry",
  "description": "Stacks parts vertically by default; switch Direction to Horizontal for side-by-side layouts. Add a Flex Item only when an item needs its own sizing or styling.",
  "group": "Layout",
  "id": "foundry.layout.flexbox",
  "icon": {
    "symbol": "app.dashed",
    "tint": "blue"
  },
  "inspector": [
    {
      "section": "Flexbox",
      "systemImage": "rectangle.3.group",
      "controls": [
        {
          "type": "childPicker",
          "id": "content",
          "label": "Items",
          "pickerItems": [
            "foundry.layout.flexitem"
          ],
          "accepts": [
            "*"
          ],
          "minimum": 0,
          "containment": "open",
          "tooltip": "Drop any part directly into the layout. Add a Flex Item only when an item needs its own size, background, padding or alignment."
        },
        {
          "type": "divider"
        },
        {
          "type": "flexbox",
          "id": "flexbox",
          "defaults": {
            "direction": "column",
            "wrap": "nowrap",
            "alignItems": "flex-start"
          }
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "defaults": {
            "widthMode": "full"
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "image",
            "gradient",
            "video"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Shadow",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          }
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "section": "Link",
      "systemImage": "link",
      "controls": [
        {
          "type": "linkOverlay",
          "id": "link"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "flex",
    "stack"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Flexbox",
  "version": "2.2.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "Responsive two-dimensional layouts with fixed or automatic columns.",
  "group": "Layout",
  "icon": {
    "symbol": "app.grid.2x2",
    "tint": "blue"
  },
  "id": "foundry.layout.grid",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": "count"
          },
          "id": "gridMode",
          "label": "Columns",
          "options": [
            {
              "title": "Fixed Count",
              "value": "count"
            },
            {
              "title": "Fit to Width",
              "value": "auto"
            }
          ],
          "presentation": "segmented",
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": 1,
            "large": 3,
            "medium": 2
          },
          "id": "columnCount",
          "label": "Column Count",
          "maximum": 12,
          "minimum": 1,
          "responsive": true,
          "step": 1,
          "type": "number",
          "visibleWhen": {
            "id": "gridMode",
            "value": "count"
          }
        },
        {
          "defaults": {
            "base": 240
          },
          "id": "minimumColumnWidth",
          "label": "Minimum Width",
          "maximum": 2000,
          "minimum": 40,
          "responsive": true,
          "step": 1,
          "tooltip": "Adds columns when they fit, without overflowing narrow screens.",
          "type": "number",
          "units": "px",
          "visibleWhen": {
            "id": "gridMode",
            "value": "auto"
          }
        },
        {
          "defaults": {
            "base": "md"
          },
          "id": "frameworkGap",
          "label": "Gap",
          "responsive": true,
          "type": "frameworkSpacing"
        },
        {
          "defaults": {
            "base": "md"
          },
          "id": "rowGap",
          "label": "Row Gap",
          "responsive": true,
          "type": "frameworkSpacing"
        },
        {
          "defaults": {
            "base": "auto"
          },
          "id": "rowSizing",
          "label": "Row Height",
          "options": [
            {
              "title": "Fit content",
              "value": "auto"
            },
            {
              "title": "Equal height",
              "value": "equal"
            }
          ],
          "presentation": "segmented",
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": "stretch"
          },
          "id": "alignItems",
          "label": "Align",
          "options": [
            {
              "title": "Stretch",
              "value": "stretch"
            },
            {
              "title": "Start",
              "value": "flex-start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "flex-end"
            }
          ],
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": "stretch"
          },
          "id": "justifyItems",
          "label": "Align Horizontally",
          "options": [
            {
              "title": "Stretch",
              "value": "stretch"
            },
            {
              "title": "Start",
              "value": "start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "end"
            }
          ],
          "responsive": true,
          "type": "select"
        },
        {
          "accepts": [
            "*"
          ],
          "id": "content",
          "label": "Items",
          "pickerItems": [
            "foundry.layout.grid-item"
          ],
          "tooltip": "Grid Items carry per-item Span Columns and Span Rows controls. Any part can also be dropped in directly.",
          "type": "childPicker"
        }
      ],
      "section": "Layout",
      "systemImage": "rectangle.3.group"
    },
    {
      "controls": [
        {
          "type": "sizing"
        },
        {
          "defaults": {
            "base": "visible"
          },
          "id": "overflow",
          "label": "Overflow",
          "options": [
            {
              "title": "Visible",
              "value": "visible"
            },
            {
              "title": "Clip",
              "value": "hidden"
            },
            {
              "title": "Scroll when needed",
              "value": "auto"
            }
          ],
          "responsive": true,
          "tooltip": "Clipping can hide shadows or focus outlines.",
          "type": "select"
        }
      ],
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right"
    },
    {
      "controls": [
        {
          "type": "spacing"
        }
      ],
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right"
    },
    {
      "controls": [
        {
          "type": "background"
        }
      ],
      "section": "Background",
      "systemImage": "paintbrush.fill"
    },
    {
      "controls": [
        {
          "type": "borders"
        }
      ],
      "section": "Borders",
      "systemImage": "square.dashed"
    },
    {
      "controls": [
        {
          "type": "effects"
        }
      ],
      "section": "Effects",
      "systemImage": "sparkles"
    },
    {
      "controls": [
        {
          "type": "reveal"
        }
      ],
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "flex"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Grid",
  "version": "2.2.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "Responsive two-dimensional layouts with fixed or automatic columns.",
  "group": "Layout",
  "icon": {
    "symbol": "app.grid.2x2",
    "tint": "blue"
  },
  "id": "foundry.layout.grid",
  "inspector": [
    {
      "section": "Grid",
      "systemImage": "app.grid.2x2",
      "controls": [
        {
          "type": "childPicker",
          "id": "content",
          "label": "Items",
          "buttonText": "Add Grid Item",
          "pickerItems": [
            "foundry.layout.griditem"
          ],
          "accepts": [
            "*"
          ],
          "initial": [
            "foundry.layout.griditem",
            "foundry.layout.griditem",
            "foundry.layout.griditem"
          ],
          "minimum": 0,
          "containment": "open",
          "tooltip": "Drop any part straight into the grid, one per cell. Add a Grid Item when a cell needs to span columns or rows, or have its own background, padding or alignment."
        },
        {
          "type": "divider"
        },
        {
          "defaults": {
            "base": "count"
          },
          "id": "gridMode",
          "label": "Columns",
          "options": [
            {
              "title": "Fixed Count",
              "value": "count"
            },
            {
              "title": "Fit to Width",
              "value": "auto"
            }
          ],
          "presentation": "segmented",
          "responsive": true,
          "type": "select"
        },
        {
          "defaults": {
            "base": false
          },
          "id": "previewColumns",
          "label": "Preview Grid",
          "tooltip": "Shows the grid's tracks on the canvas when columns or rows use a fixed count. Never appears in preview or published pages.",
          "type": "toggle",
          "visibleWhen": {
            "any": [
              {
                "id": "gridMode",
                "value": "count"
              },
              {
                "id": "rowCount",
                "operation": ">",
                "value": 0
              }
            ]
          }
        },
        {
          "id": "columnCount",
          "label": "Columns",
          "type": "slider",
          "minimum": 1,
          "maximum": 12,
          "step": 1,
          "ticks": 12,
          "editableValue": false,
          "defaults": {
            "base": 1,
            "large": 3,
            "medium": 2
          },
          "responsive": true,
          "visibleWhen": {
            "id": "gridMode",
            "value": "count"
          }
        },
        {
          "defaults": {
            "base": 240
          },
          "id": "minimumColumnWidth",
          "label": "Minimum Width",
          "maximum": 2000,
          "minimum": 40,
          "responsive": true,
          "step": 1,
          "tooltip": "Adds columns when they fit, without overflowing narrow screens.",
          "type": "number",
          "units": "px",
          "visibleWhen": {
            "id": "gridMode",
            "value": "auto"
          }
        },
        {
          "type": "slider",
          "id": "rowCount",
          "label": "Rows",
          "minimum": 0,
          "maximum": 12,
          "step": 1,
          "ticks": 13,
          "valueLabels": {
            "0": "Auto"
          },
          "tooltip": "Auto rows grow to fit their content. A fixed count shares the grid's height equally between that many rows; set it per breakpoint, because fewer columns on small screens need more rows.",
          "defaults": {
            "base": 0
          },
          "responsive": true
        },
        {
          "defaults": {
            "base": "md"
          },
          "id": "frameworkGap",
          "label": "Column Gap",
          "responsive": true,
          "type": "frameworkSpacing"
        },
        {
          "defaults": {
            "base": "md"
          },
          "id": "rowGap",
          "label": "Row Gap",
          "responsive": true,
          "type": "frameworkSpacing"
        },
        {
          "defaults": {
            "base": "auto"
          },
          "id": "rowSizing",
          "label": "Row Height",
          "options": [
            {
              "title": "Fit content",
              "value": "auto"
            },
            {
              "title": "Equal height",
              "value": "equal"
            }
          ],
          "presentation": "segmented",
          "responsive": true,
          "type": "select",
          "visibleWhen": {
            "id": "rowCount",
            "value": 0
          }
        },
        {
          "type": "select",
          "id": "autoFlow",
          "label": "Placement",
          "options": [
            {
              "title": "In Order",
              "value": "row"
            },
            {
              "title": "Fill Gaps",
              "value": "row dense"
            }
          ],
          "presentation": "segmented",
          "tooltip": "Fill Gaps moves later items back into holes left by items that span several columns. The visual order can then differ from the reading and keyboard order.",
          "defaults": {
            "base": "row"
          },
          "responsive": true
        },
        {
          "defaults": {
            "base": "normal"
          },
          "id": "alignItems",
          "label": "Align Vertically",
          "options": [
            {
              "title": "Auto",
              "value": "normal"
            },
            {
              "title": "Stretch",
              "value": "stretch"
            },
            {
              "title": "Start",
              "value": "start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "end"
            }
          ],
          "responsive": true,
          "type": "select",
          "tooltip": "Auto stretches boxes such as Grid Items to fill their cell, while images and video keep their proportions."
        },
        {
          "defaults": {
            "base": "normal"
          },
          "id": "justifyItems",
          "label": "Align Horizontally",
          "options": [
            {
              "title": "Auto",
              "value": "normal"
            },
            {
              "title": "Stretch",
              "value": "stretch"
            },
            {
              "title": "Start",
              "value": "start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "end"
            }
          ],
          "responsive": true,
          "type": "select",
          "tooltip": "Auto stretches boxes such as Grid Items to fill their cell, while images and video keep their proportions."
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "defaults": {
            "widthMode": "full"
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background"
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          },
          "id": "layout"
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "grid",
    "columns"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html",
    "editorCSS": "editor.css"
  },
  "title": "Grid",
  "version": "3.0.0"
}

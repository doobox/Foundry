{
  "assets": [],
  "author": "Foundry",
  "description": "Responsive two-dimensional layouts with fixed or automatic columns.",
  "group": "Layout",
  "id": "foundry.layout.grid",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": "count"
          },
          "id": "gridMode",
          "label": "Grid Template Columns",
          "options": [
            {
              "title": "Repeat Column Count",
              "value": "count"
            },
            {

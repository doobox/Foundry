{
  "assets": [],
  "author": "Foundry",
  "description": "Creates a styled link for calls to action and navigation.",
  "group": "Content",
  "icon": {
    "symbol": "inset.filled.capsule",
    "tint": "orange"
  },
  "id": "foundry.content.button",
  "libraries": [
    {
      "id": "bootstrap",
      "majorVersion": 6
    }
  ],
  "inspector": [
    {
      "controls": [
        {
          "absoluteURL": false,
          "defaults": {
            "base": "#"
          },
          "id": "destination",
          "label": "Destination",
          "type": "link"
        }
      ],
      "section": "Link",
      "systemImage": "link"
    },
    {
      "controls": [
        {
          "type": "themeColor",
          "id": "theme",
          "label": "Theme",
          "defaults": { "base": "framework.primary" }
        },
        {
          "type": "select",
          "id": "variant",
          "label": "Variant",
          "defaults": { "base": "btn-solid" },
          "options": [
            { "title": "Solid", "value": "btn-solid" },
            { "title": "Subtle", "value": "btn-subtle" },
            { "title": "Outline", "value": "btn-outline" }
          ]
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "defaults": { "base": "" },
          "options": [
            { "title": "Small", "value": "btn-sm" },
            { "title": "Default", "value": "" },
            { "title": "Large", "value": "btn-lg" }
          ]
        }
      ],
      "section": "Appearance",
      "systemImage": "paintpalette"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "accessibilityLabel",
          "label": "Accessibility label",
          "responsive": false,
          "type": "text"
        }
      ],
      "section": "Accessibility",
      "systemImage": "accessibility"
    },
    {
      "section": "Content",
      "systemImage": "doc.text"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "link"
  ],
  "templates": {
    "html": "part.html"
  },
  "title": "Button",
  "version": "3.0.0"
}

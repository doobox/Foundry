{
  "assets": [],
  "author": "Foundry",
  "description": "Creates a styled link for calls to action and navigation.",
  "group": "Content",
  "id": "foundry.content.button",
  "inspector": [
    {
      "controls": [
        {
          "absoluteURL": false,
          "defaults": {
            "base": "#"
          },
          "id": "destination",
          "label": "Destination",
          "responsive": false,
          "type": "link"
        }
      ],
      "section": "Link",
      "systemImage": "link"
    },
    {
      "controls": [
        {
          "allowsCustom": true,
          "customColor": "#FFFFFF",
          "defaults": {
            "base": {
              "palette": "custom"
            }
          },
          "id": "textColor",
          "label": "Text colour",
          "opacity": true,
          "responsive": true,
          "type": "frameworkColor"
        }
      ],
      "section": "Typography",
      "systemImage": "textformat"
    },
    {
      "controls": [
        {
          "allowsCustom": true,
          "customColor": "#5B5BD6",
          "defaults": {
            "base": {
              "palette": "custom"
            }
          },
          "id": "backgroundColor",
          "label": "Background",
          "opacity": true,
          "responsive": true,
          "type": "frameworkColor"
        },
        {
          "defaults": {
            "base": 10
          },
          "id": "cornerRadius",
          "label": "Corner radius",
          "maximum": 120,
          "minimum": 0,
          "responsive": true,
          "step": 1,
          "type": "number",
          "units": "px"
        }
      ],
      "section": "Appearance",
      "systemImage": "paintpalette"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "accessibilityLabel",
          "label": "Accessibility label",
          "responsive": false,
          "type": "text"
        }
      ],
      "section": "Accessibility",
      "systemImage": "accessibility"
    },
    {
      "type": "reveal"
    },
    {
      "section": "Content",
      "systemImage": "doc.text"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "link"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Button",
  "version": "1.0.0"
}

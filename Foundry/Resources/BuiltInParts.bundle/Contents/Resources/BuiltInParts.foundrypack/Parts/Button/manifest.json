{
  "assets": [],
  "author": "Foundry",
  "description": "Creates a styled link for calls to action and navigation.",
  "group": "Content",
  "icon": {
    "symbol": "inset.filled.capsule",
    "tint": "orange"
  },
  "id": "foundry.content.button",
  "libraries": [
    {
      "id": "bootstrap",
      "majorVersion": 6
    }
  ],
  "inspector": [
    {
      "controls": [
        {
          "absoluteURL": false,
          "defaults": {
            "base": "#"
          },
          "id": "destination",
          "label": "Destination",
          "type": "link"
        }
      ],
      "section": "Link",
      "systemImage": "link"
    },
    {
      "controls": [
        {
          "type": "themeColor",
          "id": "theme",
          "label": "Theme",
          "defaults": { "base": "framework.primary" }
        },
        {
          "type": "select",
          "id": "variant",
          "label": "Variant",
          "defaults": { "base": "btn-solid" },
          "options": [
            { "title": "Solid", "value": "btn-solid" },
            { "title": "Styled", "value": "btn-solid btn-styled" },
            { "title": "Subtle", "value": "btn-subtle" },
            { "title": "Outline", "value": "btn-outline" },
            { "title": "Text", "value": "btn-text" },
            { "title": "Link", "value": "btn-link" }
          ]
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "defaults": { "base": "" },
          "options": [
            { "title": "Extra small", "value": "btn-xs" },
            { "title": "Small", "value": "btn-sm" },
            { "title": "Default", "value": "" },
            { "title": "Large", "value": "btn-lg" }
          ]
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "defaults": { "base": "" },
          "options": [
            { "title": "Default", "value": "" },
            { "title": "Pill", "value": "rounded-pill" },
            { "title": "Square corners", "value": "rounded-0" }
          ]
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "visibleWhen": { "id": "iconPosition", "operation": "!=", "value": "only" },
          "defaults": { "base": "" },
          "options": [
            { "title": "Fit content", "value": "" },
            { "title": "Full width", "value": "w-100" }
          ],
          "subtitle": "Icon-only buttons keep their square proportions."
        }
      ],
      "section": "Appearance",
      "systemImage": "paintpalette"
    },
    {
      "section": "Icon",
      "systemImage": "star",
      "controls": [
        {
          "type": "select",
          "id": "iconPosition",
          "label": "Placement",
          "defaults": { "base": "none" },
          "options": [
            { "title": "None", "value": "none" },
            { "title": "Before text", "value": "before" },
            { "title": "After text", "value": "after" },
            { "title": "Icon only", "value": "only" }
          ]
        },
        {
          "type": "icon",
          "id": "symbol",
          "label": "Icon",
          "defaults": { "base": "arrow-right" },
          "visibleWhen": { "id": "iconPosition", "operation": "!=", "value": "none" }
        }
      ]
    },
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "accessibilityLabel",
          "label": "Accessibility label",
          "responsive": false,
          "type": "text"
        }
      ],
      "section": "Accessibility",
      "systemImage": "accessibility"
    },
    {
      "section": "Content",
      "systemImage": "doc.text"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "link"
  ],
  "templates": {
    "html": "part.html"
  },
  "title": "Button",
  "version": "3.1.0"
}

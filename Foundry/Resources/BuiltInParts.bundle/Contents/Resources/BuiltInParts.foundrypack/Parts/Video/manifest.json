{
  "assets": [],
  "author": "Foundry",
  "description": "Displays a responsive project video.",
  "group": "Media",
  "icon": {
    "symbol": "video",
    "tint": "red"
  },
  "id": "foundry.media.video",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "source",
          "label": "Video",
          "type": "video"
        }
      ],
      "section": "Content",
      "systemImage": "doc.text"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": 1200
          },
          "id": "maxWidth",
          "label": "Max Width",
          "maximum": 2400,
          "minimum": 100,
          "responsive": true,
          "step": 10,
          "type": "number",
          "units": "px"
        },
        {
          "defaults": {
            "base": "center"
          },
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "title": "Start",
              "value": "start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "end"
            }
          ],
          "responsive": true,
          "type": "select"
        }
      ],
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right"
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "gradient",
            "image"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout"
        }
      ]

{
  "assets": [],
  "author": "Foundry",
  "description": "Displays a responsive project image.",
  "group": "Media",
  "icon": {
    "symbol": "photo",
    "tint": "red"
  },
  "id": "foundry.media.image",
  "inspector": [
    {
      "controls": [
        {
          "id": "source",
          "label": "Image",
          "type": "image",
          "focalPoint": true,
          "renditions": [
            {
              "id": "small",
              "maximumDimension": 480
            },
            {
              "id": "medium",
              "maximumDimension": 960
            },
            {
              "id": "large",
              "maximumDimension": 1600
            }
          ]
        },
        {
          "defaults": {
            "base": "fill"
          },
          "id": "imageWidth",
          "label": "Width",
          "options": [
            {
              "title": "Fill part",
              "value": "fill"
            },
            {
              "title": "Original size",
              "value": "original"
            },
            {
              "title": "Custom",
              "value": "custom"
            }
          ],
          "responsive": true,
          "type": "select",
          "tooltip": "Fill part stretches the picture to the part's width. Original size shows it at its own pixels, never larger than the part. Custom sets an exact width."
        },
        {
          "defaults": {
            "base": 400
          },
          "id": "imageCustomWidth",
          "label": "Image width",
          "maximum": 4000,
          "minimum": 16,
          "responsive": true,
          "step": 1,
          "type": "number",
          "units": "px",
          "valueAvailability": "whenVisible",
          "visibleWhen": {
            "id": "imageWidth",
            "value": "custom"
          }
        },
        {
          "defaults": {
            "base": "cover"
          },
          "id": "fit",
          "label": "Fit",
          "options": [
            {
              "title": "Cover",
              "value": "cover"
            },
            {
              "title": "Contain",
              "value": "contain"
            }
          ],
          "responsive": true,
          "type": "select",
          "tooltip": "Cover fills the part and crops around the focal point. Contain shows the whole image and leaves space around it. Shown once a height, ratio or height limit gives the part a shape of its own.",
          "visibleWhen": {
            "any": [
              {
                "id": "sizing.heightMode",
                "operation": "!=",
                "value": "auto"
              },
              {
                "id": "sizing.aspectRatio",
                "operation": "!=",
                "value": "none"
              },
              {
                "id": "sizing.minHeight",
                "operation": "isNotEmpty"
              },
              {
                "id": "sizing.maxHeight",
                "operation": "isNotEmpty"
              }
            ]
          }
        },
        {
          "defaults": {
            "base": "lazy"
          },
          "id": "loading",
          "label": "Loading",
          "options": [
            {
              "title": "Lazy",
              "value": "lazy"
            },
            {
              "title": "Immediate",
              "value": "eager"
            }
          ],
          "type": "select",
          "tooltip": "Lazy waits until the image is near the viewport. Use Immediate for the first image visitors see."
        }
      ],
      "section": "Content",
      "systemImage": "doc.text"
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "id": "sizing",
          "defaults": {
            "widthMode": "custom",
            "customWidth": 1200
          }
        },
        {
          "defaults": {
            "base": "center"
          },
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "title": "Start",
              "value": "start"
            },
            {
              "title": "Centre",
              "value": "center"
            },
            {
              "title": "End",
              "value": "end"
            }
          ],
          "responsive": true,
          "type": "select",
          "tooltip": "Where the part sits when it is narrower than the space it is in, and where the picture sits inside the part when it is smaller than the part.",
          "visibleWhen": {
            "any": [
              {
                "all": [
                  {
                    "id": "sizing.widthMode",
                    "operation": "!=",
                    "value": "full"
                  },
                  {
                    "id": "sizing.widthMode",
                    "operation": "!=",
                    "value": "screen"
                  }
                ]
              },
              {
                "id": "imageWidth",
                "operation": "!=",
                "value": "fill"
              }
            ]
          }
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "gradient",
            "image"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Effects",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          }
        }
      ]
    },
    {
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ],
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": ""
          },
          "id": "destination",
          "label": "Destination",
          "tooltip": "Makes the whole part one link. The overlay also covers links and buttons inside; avoid nesting interactive content when enabled.",
          "type": "link"
        },
        {
          "defaults": {
            "base": ""
          },
          "id": "linkLabel",
          "label": "Accessible name",
          "tooltip": "Describes the destination for screen readers, which cannot see the part's contents.",
          "type": "text",
          "visibleWhen": {
            "id": "destination",
            "operation": "isNotEmpty"
          }
        }
      ],
      "section": "Link",
      "systemImage": "link"
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in"
  ],
  "templates": {
    "editorCSS": "editor.css",
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Image",
  "version": "1.3.0"
}

{
  "assets": [],
  "author": "Foundry",
  "description": "A page section. Backgrounds, borders and padding span its full width; inside, content stacks like an ordinary block and stays within the site's content width.",
  "group": "Layout",
  "icon": {
    "symbol": "rectangle",
    "tint": "blue"
  },
  "id": "foundry.layout.section",
  "inspector": [
    {
      "section": "Section",
      "systemImage": "rectangle.center.inset.filled",
      "controls": [
        {
          "type": "select",
          "id": "contentWidth",
          "label": "Content width",
          "defaults": {
            "base": "breakpoint"
          },
          "options": [
            {
              "value": "auto",
              "title": "Fit content"
            },
            {
              "value": "full",
              "title": "Full"
            },
            {
              "value": "breakpoint",
              "title": "Site width"
            },
            {
              "value": "custom",
              "title": "Custom"
            }
          ],
          "responsive": true,
          "tooltip": "Sets the inner content area's width, not the whole part. Fit content shrinks to the content. Full spans the section. Site width follows the project's responsive content width. Custom sets an exact width."
        },
        {
          "type": "frameworkSpacing",
          "id": "contentWidthSpacing",
          "label": "Custom width",
          "defaults": {
            "base": {
              "value": 800,
              "unit": "px"
            }
          },
          "noneValue": "auto",
          "responsive": true,
          "visibleWhen": {
            "id": "contentWidth",
            "value": "custom"
          }
        },
        {
          "type": "select",
          "id": "contentAlignment",
          "label": "Vertical position",
          "defaults": {
            "base": "normal"
          },
          "options": [
            {
              "value": "normal",
              "title": "Auto"
            },
            {
              "value": "start",
              "title": "Start"
            },
            {
              "value": "end",
              "title": "End"
            },
            {
              "value": "center",
              "title": "Centre"
            },
            {
              "value": "stretch",
              "title": "Stretch"
            }
          ],
          "responsive": true,
          "tooltip": "Where the content box sits when the section is taller than its content.",
          "visibleWhen": {
            "any": [
              {
                "id": "sizing.heightMode",
                "operation": "!=",
                "value": "auto"
              },
              {
                "id": "sizing.minHeight",
                "operation": "isNotEmpty"
              }
            ]
          }
        },
        {
          "type": "frameworkSpacing",
          "id": "contentGap",
          "label": "Gap",
          "defaults": {
            "base": "none"
          },
          "noneValue": "normal",
          "responsive": true,
          "tooltip": "Space between the parts stacked inside. None uses the normal automatic gap (zero for this layout)."
        }
      ]
    },
    {
      "section": "Sizing",
      "systemImage": "arrow.up.left.and.arrow.down.right",
      "controls": [
        {
          "type": "sizing",
          "defaults": {
            "widthMode": "full"
          },
          "id": "sizing"
        }
      ]
    },
    {
      "section": "Spacing",
      "systemImage": "arrow.up.and.down.and.arrow.left.and.right",
      "controls": [
        {
          "type": "spacing",
          "id": "spacing"
        }
      ]
    },
    {
      "section": "Background",
      "systemImage": "paintbrush.fill",
      "controls": [
        {
          "type": "background",
          "id": "background",
          "backgroundTypes": [
            "colour",
            "image",
            "gradient",
            "video"
          ]
        }
      ]
    },
    {
      "section": "Borders",
      "systemImage": "square.dashed",
      "controls": [
        {
          "type": "borders",
          "id": "borders"
        }
      ]
    },
    {
      "section": "Shadow",
      "systemImage": "sparkles",
      "controls": [
        {
          "type": "effects",
          "id": "effects"
        }
      ]
    },
    {
      "section": "Filters",
      "systemImage": "camera.filters",
      "controls": [
        {
          "type": "filters",
          "id": "filters"
        }
      ]
    },
    {
      "section": "Transforms",
      "systemImage": "move.3d",
      "controls": [
        {
          "type": "transforms",
          "id": "transforms"
        }
      ]
    },
    {
      "section": "Transitions",
      "systemImage": "circle.dotted.circle",
      "controls": [
        {
          "type": "transitions",
          "id": "transitions"
        }
      ]
    },
    {
      "section": "Layout",
      "systemImage": "square.on.square",
      "controls": [
        {
          "type": "layout",
          "id": "layout",
          "allowedOptions": {
            "position": [
              "relative",
              "absolute",
              "fixed",
              "sticky"
            ]
          }
        }
      ]
    },
    {
      "section": "Reveal",
      "systemImage": "sparkles.rectangle.stack",
      "controls": [
        {
          "type": "reveal",
          "id": "reveal"
        }
      ]
    },
    {
      "section": "Link",
      "systemImage": "link",
      "controls": [
        {
          "type": "linkOverlay",
          "id": "link"
        }
      ]
    },
    {
      "type": "advanced"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Foundry",
    "built-in",
    "layout",
    "section",
    "section"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Section",
  "version": "4.0.0"
}

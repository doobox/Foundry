{
  "assets": [
    {
      "path": "icon.svg"
    }
  ],
  "author": "Foundry Development",
  "description": "Interactive examples of calculations, comparisons, logic, functions and conditional branches.",
  "group": "Other",
  "id": "dev.foundry.expression-engine",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "base": "featured"
          },
          "id": "status",
          "label": "Status",
          "options": [
            {
              "title": "Featured",
              "value": "featured"
            },
            {
              "title": "Draft",
              "value": "draft"
            },
            {
              "title": "Standard",
              "value": "standard"
            }
          ],
          "responsive": false,
          "type": "select"
        },
        {
          "defaults": {
            "base": true
          },
          "id": "enabled",
          "label": "Enabled",
          "responsive": false,
          "type": "toggle"
        },
        {
          "defaults": {
            "base": 72
          },
          "id": "score",
          "label": "Score",
          "maximum": 100,
          "minimum": 0,
          "responsive": false,
          "step": 1,
          "type": "number"
        },
        {
          "defaults": {
            "base": 60
          },
          "id": "threshold",
          "label": "Threshold",
          "maximum": 100,
          "minimum": 0,
          "responsive": false,
          "step": 1,
          "type": "number"
        }
      ],
      "section": "Conditions"
    },
    {
      "controls": [
        {
          "defaults": {
            "base": 10
          },
          "id": "base",
          "label": "Base",
          "maximum": 100,
          "minimum": -100,
          "responsive": false,
          "step": 1,
          "type": "number"
        },
        {
          "defaults": {
            "base": 6
          },
          "id": "offset",
          "label": "Offset",
          "maximum": 100,
          "minimum": -100,
          "responsive": false,
          "step": 1,
          "type": "number"
        },
        {
          "defaults": {
            "base": 3
          },
          "id": "multiplier",
          "label": "Multiplier",
          "maximum": 10,
          "minimum": -10,
          "responsive": false,
          "step": 1,
          "type": "number"
        }
      ],
      "section": "Arithmetic"
    },
    {
      "controls": [
        {
          "count": 2,
          "defaults": {
            "base": [
              "Alpha",
              "Beta"
            ]
          },
          "id": "labels",
          "label": "Labels",
          "responsive": false,
          "type": "text"
        }
      ],
      "section": "Indexed values"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Development",
    "Expressions"
  ],
  "templates": {
    "files": [
      {
        "path": "part.css",
        "scope": "instance"
      }
    ],
    "html": "part.html"
  },
  "title": "Expression Engine Demo",
  "version": "1.0.0"
}

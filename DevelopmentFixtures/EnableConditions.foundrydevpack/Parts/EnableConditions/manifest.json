{
  "assets": [
    {
      "path": "icon.svg"
    }
  ],
  "author": "Foundry Development",
  "description": "Demonstrates conditional control visibility.",
  "group": "Other",
  "id": "dev.foundry.enable-conditions",
  "inspector": [
    {
      "controls": [
        {
          "defaults": {
            "xs": "standard"
          },
          "id": "mode",
          "label": "Mode",
          "options": [
            {
              "title": "Standard",
              "value": "standard"
            },
            {
              "title": "Featured",
              "value": "featured"
            }
          ],
          "responsive": false,
          "type": "select"
        },
        {
          "defaults": {
            "xs": "A featured title"
          },
          "id": "featuredTitle",
          "label": "Featured title",
          "responsive": false,
          "type": "text",
          "visibleWhen": {
            "id": "mode",
            "value": "featured"
          }
        },
        {
          "defaults": {
            "xs": 400
          },
          "id": "width",
          "label": "Width",
          "maximum": 1000,
          "minimum": 0,
          "responsive": false,
          "step": 10,
          "type": "number",
          "units": "px"
        },
        {
          "body": "Width is at least 600 px",
          "id": "wideMessage",
          "type": "note",
          "visibleWhen": {
            "id": "width",
            "operation": ">=",
            "value": 600
          }
        },
        {
          "count": 3,
          "defaults": {
            "xs": [
              "Alpha",
              "Beta",
              "Ordinary"
            ]
          },
          "id": "titles",
          "label": "Titles",
          "responsive": false,
          "subtitle": [
            "Title 1",
            "Title 2",
            "Title 3"
          ],
          "type": "text"
        },
        {
          "body": "Third title contains “featured”",
          "id": "thirdTitleMessage",
          "type": "note",
          "visibleWhen": {
            "id": "titles[2]",
            "operation": "containsInsensitive",
            "value": "featured"
          }
        },
        {
          "defaults": {
            "xs": ""
          },
          "id": "note",
          "label": "Optional note",
          "responsive": false,
          "type": "text"
        },
        {
          "body": "The optional note is empty",
          "id": "emptyMessage",
          "type": "note",
          "visibleWhen": {
            "id": "note",
            "operation": "isEmpty"
          }
        },
        {
          "defaults": {
            "xs": "This appears after entering a note."
          },
          "id": "noteDetail",
          "label": "Note detail",
          "responsive": false,
          "type": "textArea",
          "visibleWhen": {
            "id": "note",
            "operation": "isNotEmpty"
          }
        }
      ],
      "section": "Visibility Demo"
    }
  ],
  "minimumAPIVersion": 1,
  "tags": [
    "Development",
    "Conditional"
  ],
  "templates": {
    "html": "part.html"
  },
  "title": "Visibility Conditions Demo",
  "version": "1.0.0"
}

#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
docs_repository=$(CDPATH= cd -- "$repository_root/../docs" && pwd)
docs_server="$docs_repository/serve-docs"

if [ ! -x "$docs_server" ]; then
    echo "Foundry API docs repository or serving script not found:" >&2
    echo "  $docs_server" >&2
    echo "The docs are a separate repository beside app in the Foundry workspace." >&2
    exit 1
fi

cd "$docs_repository"
exec "$docs_server"

#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
docs_repository=$(CDPATH= cd -- "$repository_root/../.." && pwd)/Foundry\ Developer\ API
docs_server="$docs_repository/serve-docs"

if [ ! -x "$docs_server" ]; then
    echo "Foundry API docs repository or serving script not found:" >&2
    echo "  $docs_server" >&2
    echo "The docs are a separate sibling repository, not a docs folder in the app repository." >&2
    exit 1
fi

cd "$docs_repository"
exec "$docs_server"
